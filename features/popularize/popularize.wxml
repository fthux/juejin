<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="popularize-page">
  <view class="popularize-head"><text>推广中心</text><text class="help">规则&amp;帮助</text></view>
  <view class="withdraw-card"><view>可提现金额　?</view><view class="withdraw-value">¥ 0.00</view><view class="withdraw-button">提现</view></view>
  <view class="section-title">推广课程列表</view>
  <scroll-view class="category-tabs" scroll-x>
    <view wx:for="{{tabs}}" wx:key="*this" class="category-tab {{activeTab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="selectTab">{{item}}</view>
  </scroll-view>
  <view wx:for="{{courses}}" wx:key="title" class="course-row">
    <view class="course-title">{{item.title}}</view>
    <view class="course-author">{{item.author}}</view>
    <view class="course-price"><text>{{item.price}}</text> <text class="old-price">{{item.oldPrice}}</text><text class="reward">{{item.reward}}</text></view>
  </view>
</view>
