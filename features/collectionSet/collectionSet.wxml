<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page collection-page">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id" class="tab {{activeTab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="switchTab">{{item.name}}</view>
  </view>
  <view wx:if="{{activeTab !== 'bookshelf'}}">
    <article-card wx:for="{{articles}}" wx:key="article_id" item="{{item}}" bind:open="openArticle"></article-card>
    <empty-state wx:if="{{!articles.length}}" text="这里还没有内容"></empty-state>
  </view>
  <view wx:else>
    <course-card wx:for="{{books}}" wx:key="id" item="{{item}}" bind:open="openCourse"></course-card>
    <empty-state wx:if="{{!books.length}}" text="书架还是空的"></empty-state>
  </view>
</view>
