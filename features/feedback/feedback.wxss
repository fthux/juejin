.feedback-page {
  padding: 18rpx 0 48rpx;
  background: var(--jj-bg);
}

.feedback-section {
  position: relative;
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
  background: var(--jj-surface);
}

.field-title {
  margin-bottom: 22rpx;
  color: var(--jj-text);
  font-size: 29rpx;
  font-weight: 600;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  color: var(--jj-text-2);
  background: var(--jj-fill);
  font-size: 24rpx;
}

.type-chip.active {
  color: var(--jj-blue);
  background: var(--jj-blue-soft);
}

textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 20rpx;
  border-radius: 6rpx;
  box-sizing: border-box;
  color: var(--jj-text);
  background: var(--jj-fill-2);
}

input {
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 6rpx;
  color: var(--jj-text);
  background: var(--jj-fill-2);
}

.length {
  position: absolute;
  right: 48rpx;
  bottom: 40rpx;
  color: var(--jj-text-3);
  font-size: 21rpx;
}

.submit-button {
  height: 80rpx;
  margin: 34rpx 32rpx 0;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: var(--jj-blue);
  font-size: 28rpx;
}
