<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page feedback-page">
  <view class="feedback-section">
    <view class="field-title">反馈类型</view>
    <view class="type-list">
      <view wx:for="{{types}}" wx:key="*this" class="type-chip {{activeType === item ? 'active' : ''}}" data-type="{{item}}" bindtap="selectType">{{item}}</view>
    </view>
  </view>

  <view class="feedback-section">
    <view class="field-title">问题与建议</view>
    <textarea value="{{content}}" maxlength="1000" placeholder="请描述你遇到的问题" bindinput="onContentInput"></textarea>
    <view class="length">{{content.length}}/1000</view>
  </view>

  <view class="feedback-section">
    <view class="field-title">联系方式（选填）</view>
    <input value="{{contact}}" maxlength="80" placeholder="邮箱或其他联系方式" bindinput="onContactInput"></input>
  </view>

  <view class="submit-button" bindtap="submit">提交反馈</view>
</view>
