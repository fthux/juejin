.about-page {
  padding-top: 16rpx;
  background: var(--jj-bg);
}

.about-row {
  min-height: 98rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--jj-line);
  color: var(--jj-text);
  font-size: 28rpx;
}

.about-row:last-child {
  border-bottom: 0;
}

.arrow {
  color: var(--jj-text-3);
  font-size: 42rpx;
  font-weight: 200;
}
