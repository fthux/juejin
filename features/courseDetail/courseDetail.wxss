.course-detail-page {
  min-height: 100vh;
  padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
  background: var(--jj-surface);
}

.loading-page {
  padding-top: 180rpx;
}

.course-hero {
  position: relative;
  min-height: 318rpx;
  overflow: hidden;
  color: #ffffff;
  background: #426896;
}

.hero-background {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-copy {
  position: relative;
  z-index: 1;
  padding: 34rpx 30rpx 56rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1.42;
}

.hero-vip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 1rpx 9rpx;
  border: 1rpx solid #fff1cd;
  border-radius: 4rpx;
  color: #806126;
  background: linear-gradient(135deg, #fde8c3, #edd3a7);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.45;
  vertical-align: 4rpx;
}

.hero-summary {
  margin-top: 15rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.hero-author {
  min-height: 58rpx;
  margin-top: 62rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 25rpx;
}

.hero-author-pressed {
  opacity: 0.72;
}

.hero-author image {
  width: 58rpx;
  height: 58rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: #ffffff;
}

.author-level {
  height: 30rpx;
  padding: 0 9rpx;
  border-radius: 4rpx;
  color: #eaf4ff;
  background: #3495db;
  font-size: 18rpx;
  font-style: italic;
  font-weight: 700;
  line-height: 30rpx;
}

.course-stats {
  min-height: 122rpx;
  margin: 32rpx 30rpx 20rpx;
  padding: 18rpx 0;
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  box-sizing: border-box;
  background: var(--jj-fill-2);
}

.stat-block {
  min-width: 0;
  text-align: center;
}

.stat-value {
  color: var(--jj-text);
  font-size: 31rpx;
}

.stat-label {
  margin-top: 6rpx;
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.stat-divider {
  height: 76rpx;
  background: var(--jj-line);
}

.detail-tabs {
  position: sticky;
  top: 0;
  z-index: 30;
  height: 92rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: var(--jj-surface);
  border-bottom: 1rpx solid var(--jj-line);
}

.detail-tabs.four-tabs {
  grid-template-columns: repeat(4, 1fr);
}

.detail-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-3);
  font-size: 29rpx;
}

.detail-tab.active {
  color: var(--jj-blue);
  font-weight: 600;
}

.detail-tab-label {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.tab-trial-label {
  position: absolute;
  left: 100%;
  top: -8rpx;
  width: 48rpx;
  height: 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff7426;
  background: #fff2e8;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 24rpx;
  white-space: nowrap;
}

.detail-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 38rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--jj-blue);
  transform: translateX(-50%);
}

.tab-panel {
  min-height: 760rpx;
  background: var(--jj-surface);
}

.intro-panel {
  padding: 34rpx 30rpx 48rpx;
  box-sizing: border-box;
}

.intro-content {
  display: block;
  overflow: hidden;
  color: var(--jj-text);
  font-size: 29rpx;
  line-height: 1.85;
  word-break: break-word;
}

.intro-content image {
  max-width: 100%;
  height: auto;
}

.intro-image {
  width: 100%;
  margin: 14rpx 0 24rpx;
  display: block;
  background: var(--jj-fill);
}

.contents-heading {
  min-height: 88rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--jj-line);
  box-sizing: border-box;
}

.contents-heading text:first-child {
  color: var(--jj-text);
  font-size: 31rpx;
  font-weight: 600;
}

.contents-heading text:last-child {
  color: var(--jj-text-2);
  font-size: 23rpx;
}

.chapter-row {
  min-height: 136rpx;
  margin: 0 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--jj-line);
  box-sizing: border-box;
}

.chapter-number {
  width: 48rpx;
  flex: 0 0 auto;
  align-self: flex-start;
  padding-top: 35rpx;
  color: var(--jj-text-3);
  font-size: 25rpx;
}

.chapter-copy {
  min-width: 0;
  padding: 26rpx 18rpx 24rpx 0;
  flex: 1;
}

.chapter-title {
  color: var(--jj-text);
  font-size: 28rpx;
  line-height: 1.45;
}

.chapter-duration {
  margin-top: 7rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.trial-label {
  min-width: 66rpx;
  height: 48rpx;
  padding: 0 10rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #f59b45;
  background: #fff8ed;
  font-size: 22rpx;
}

.read-label {
  color: var(--jj-blue);
  font-size: 22rpx;
}

.lock-icon {
  position: relative;
  width: 36rpx;
  height: 32rpx;
  margin-right: 8rpx;
  border-radius: 7rpx;
  background: var(--jj-text-4);
}

.lock-icon::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: -17rpx;
  width: 20rpx;
  height: 24rpx;
  border: 6rpx solid var(--jj-text-4);
  border-bottom: 0;
  border-radius: 14rpx 14rpx 0 0;
  box-sizing: border-box;
}

.lock-icon view {
  position: absolute;
  left: 15rpx;
  top: 10rpx;
  width: 6rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background: var(--jj-surface);
}

.recommendation-panel course-card:last-child .course-card {
  border-bottom: 0;
}

.comment-row { margin: 0 30rpx; padding: 26rpx 0 24rpx; display: flex; border-bottom: 1rpx solid var(--jj-line); }

.comment-avatar {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--jj-fill);
}

.comment-body { min-width: 0; margin-left: 18rpx; flex: 1; }

.comment-user-row { display: flex; align-items: center; }

.comment-user {
  max-width: 330rpx;
  color: var(--jj-text-3);
  font-size: 24rpx;
}

.comment-author-mark {
  margin-left: 8rpx;
  padding: 1rpx 6rpx;
  border-radius: 3rpx;
  color: var(--jj-blue);
  background: var(--jj-blue-soft);
  font-size: 18rpx;
}

.comment-content { margin-top: 10rpx; color: var(--jj-text); font-size: 27rpx; line-height: 1.58; word-break: break-word; }

.comment-replies { margin-top: 14rpx; padding: 14rpx 18rpx; background: var(--jj-fill); }

.reply-row + .reply-row { margin-top: 14rpx; }

.reply-copy { color: var(--jj-text-2); font-size: 24rpx; line-height: 1.55; word-break: break-word; }

.reply-user { color: var(--jj-blue); }

.reply-time { margin-top: 4rpx; color: var(--jj-text-3); font-size: 19rpx; }

.comment-footer {
  min-height: 38rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--jj-text-3);
  font-size: 21rpx;
}

.comment-actions, .like-action { display: flex; align-items: center; }

.comment-actions { gap: 28rpx; }

.like-action { min-width: 42rpx; gap: 6rpx; }

.like-action image { width: 29rpx; height: 29rpx; }

.comments-state {
  padding: 36rpx 0;
  color: var(--jj-text-3);
  text-align: center;
  font-size: 24rpx;
}

.course-bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  min-height: 112rpx;
  padding: 12rpx 28rpx;
  display: grid;
  grid-template-columns: 106rpx 1fr;
  gap: 12rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  border-top: 1rpx solid var(--jj-line);
}

.trial-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-2);
  font-size: 21rpx;
}

.trial-icon {
  width: 34rpx;
  height: 36rpx;
  margin-bottom: 7rpx;
  flex: 0 0 auto;
}

.purchase-action {
  position: relative;
  min-height: 84rpx;
  border-radius: 7rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: var(--jj-blue);
}

.purchase-label {
  position: absolute;
  left: 0;
  top: -10rpx;
  padding: 3rpx 10rpx;
  border: 1rpx solid #ffc8c8;
  border-radius: 10rpx 10rpx 10rpx 0;
  color: #f53f3f;
  background: #fff2f2;
  font-size: 18rpx;
}

.purchase-main {
  font-size: 29rpx;
  font-weight: 600;
}

.purchase-original {
  margin-top: 3rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 18rpx;
  text-decoration: line-through;
}

@media (prefers-color-scheme: dark) {
  .course-hero {
    background: #34577f;
  }

  .trial-label {
    background: rgba(245, 155, 69, 0.14);
  }

  .tab-trial-label {
    color: #ff8541;
    background: rgba(255, 133, 65, 0.16);
  }
}
