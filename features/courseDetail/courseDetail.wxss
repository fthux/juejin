.course-detail-page {
  padding-bottom: 116rpx;
}

.course-hero {
  padding: 34rpx 32rpx;
  display: flex;
  gap: 26rpx;
}

.course-cover {
  width: 190rpx;
  height: 252rpx;
  flex: 0 0 auto;
  border-radius: 6rpx;
  background: var(--jj-fill);
}

.course-copy {
  min-width: 0;
  flex: 1;
}

.course-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.course-summary {
  margin-top: 14rpx;
  color: var(--jj-text-3);
  font-size: 25rpx;
  line-height: 1.5;
}

.course-author {
  margin-top: 20rpx;
  color: var(--jj-text-2);
  font-size: 23rpx;
}

.course-state {
  margin-top: 20rpx;
  color: #1e80ff;
  font-size: 25rpx;
}

.intro-copy {
  display: block;
  padding: 0 32rpx 32rpx;
  color: var(--jj-text-2);
  line-height: 1.7;
}

.reading-content {
  display: block;
  padding: 0 32rpx 38rpx;
  color: var(--jj-text-2);
  font-size: 28rpx;
  line-height: 1.8;
}

.chapter-row {
  min-height: 116rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-top: 1rpx solid var(--jj-line);
}

.chapter-copy {
  min-width: 0;
  flex: 1;
}

.chapter-title {
  font-size: 27rpx;
}

.chapter-duration,
.chapter-state {
  margin-top: 8rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.course-bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 106rpx;
  padding: 14rpx 24rpx;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 16rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  border-top: 1rpx solid var(--jj-line);
}
