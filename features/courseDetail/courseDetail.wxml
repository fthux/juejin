<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page course-detail-page">
  <view wx:if="{{loading}}" class="loading-line loading-page">正在加载小册...</view>
  <empty-state wx:elif="{{loadError}}" text="小册详情加载失败"></empty-state>

  <block wx:if="{{course}}">
    <view class="course-hero">
      <image wx:if="{{course.backgroundImage && !heroImageFailed}}" class="hero-background" src="{{course.backgroundImage}}" mode="aspectFill" referrer-policy="no-referrer" binderror="onHeroImageError"></image>
      <view class="hero-copy">
        <view class="hero-title"><text wx:if="{{course.vip}}" class="hero-vip">VIP</text><text>{{course.title}}</text></view>
        <view class="hero-summary">{{course.summary}}</view>
        <view class="hero-author" hover-class="hero-author-pressed" bindtap="openAuthor" aria-role="button" aria-label="查看{{course.author}}的主页">
          <image src="{{course.authorAvatar}}" mode="aspectFill"></image>
          <text>{{course.author}}</text>
          <text wx:if="{{course.authorLevel}}" class="author-level">LV.{{course.authorLevel}}</text>
        </view>
      </view>
    </view>

    <view class="course-stats">
      <view class="stat-block">
        <view class="stat-value">{{course.detail_section_count}} 小节</view>
        <view class="stat-label">约 {{course.durationText}}</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-block">
        <view class="stat-value">{{course.buy_count}} 人</view>
        <view class="stat-label">已加入学习</view>
      </view>
    </view>

    <view id="detail-tabs" class="detail-tabs {{hasComments ? 'four-tabs' : ''}}">
      <view class="detail-tab {{activeTab === 'intro' ? 'active' : ''}}" data-id="intro" bindtap="switchTab">介绍</view>
      <view class="detail-tab {{activeTab === 'contents' ? 'active' : ''}}" data-id="contents" bindtap="switchTab">
        <view class="detail-tab-label">
          <text>目录</text>
          <text wx:if="{{hasTrial}}" class="tab-trial-label">试学</text>
        </view>
      </view>
      <view wx:if="{{hasComments}}" class="detail-tab {{activeTab === 'comments' ? 'active' : ''}}" data-id="comments" bindtap="switchTab">评论</view>
      <view class="detail-tab {{activeTab === 'recommendations' ? 'active' : ''}}" data-id="recommendations" bindtap="switchTab">相关推荐</view>
    </view>

    <view wx:if="{{activeTab === 'intro'}}" class="tab-panel intro-panel">
      <block wx:for="{{introductionBlocks}}" wx:key="index">
        <rich-text wx:if="{{item.type === 'html'}}" class="intro-content" nodes="{{item.content}}" user-select></rich-text>
        <image wx:elif="{{!item.failed}}" class="intro-image" src="{{item.src}}" mode="widthFix" referrer-policy="no-referrer" data-index="{{index}}" binderror="onIntroductionImageError"></image>
      </block>
    </view>

    <view wx:elif="{{activeTab === 'contents'}}" class="tab-panel contents-panel">
      <view class="contents-heading"><text>小册内容</text><text>{{course.statusText}}</text></view>
      <view wx:for="{{chapters}}" wx:key="id" class="chapter-row" data-id="{{item.id}}" bindtap="openChapter">
        <view class="chapter-number">{{item.number}}</view>
        <view class="chapter-copy">
          <view class="chapter-title">{{item.title}}</view>
          <view class="chapter-duration">{{item.duration ? '学习时长：' + item.duration : '写作中...'}}</view>
        </view>
        <view wx:if="{{item.isFree}}" class="trial-label">试学</view>
        <view wx:elif="{{!item.unlocked}}" class="lock-icon"><view></view></view>
        <view wx:else class="read-label">阅读</view>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'comments'}}" class="tab-panel comment-panel">
      <view wx:for="{{comments}}" wx:key="id" class="comment-row">
        <image class="comment-avatar" src="{{item.avatar}}" mode="aspectFill" referrer-policy="no-referrer"></image>
        <view class="comment-body">
          <view class="comment-user-row">
            <text class="comment-user ellipsis">{{item.user}}</text>
            <text wx:if="{{item.is_author}}" class="comment-author-mark">作者</text>
          </view>
          <view class="comment-content">{{item.content}}</view>
          <view wx:if="{{item.replies.length}}" class="comment-replies">
            <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="reply-row">
              <view class="reply-copy"><text class="reply-user">{{reply.user}}</text><text wx:if="{{reply.is_author}}" class="comment-author-mark">作者</text><text wx:if="{{reply.reply_user}}"> 回复 {{reply.reply_user}}</text><text>：{{reply.content}}</text></view>
              <view class="reply-time">{{reply.time}}{{reply.digg_count_value ? ' · ' + reply.digg_count + ' 赞' : ''}}</view>
            </view>
          </view>
          <view class="comment-footer"><text>{{item.time}}</text><view class="comment-actions"><text>···</text><view class="like-action"><image src="/assets/app/find/find_page_ic_undigg.svg" mode="aspectFit"></image><text wx:if="{{item.digg_count_value}}">{{item.digg_count}}</text></view></view></view>
        </view>
      </view>
      <view wx:if="{{commentsLoading}}" class="comments-state">正在加载评论...</view>
    </view>

    <view wx:else class="tab-panel recommendation-panel">
      <course-card wx:for="{{recommendations}}" wx:key="id" item="{{item}}" bind:open="openRecommendation"></course-card>
      <empty-state wx:if="{{!recommendations.length}}" text="暂无相关推荐"></empty-state>
    </view>

    <view class="course-bottom safe-bottom">
      <view class="trial-action" bindtap="startTrial">
        <image class="trial-icon" src="{{themeName === 'dark' ? '/assets/app/course/byte/ic_course_free_try_dark.png' : '/assets/app/course/byte/ic_course_free_try.png'}}" mode="aspectFit"></image>
        <text>免费试学</text>
      </view>
      <view class="purchase-action" bindtap="buyCourse">
        <text wx:if="{{course.discountLabel}}" class="purchase-label">{{course.discountLabel}}</text>
        <view class="purchase-main">{{course.owned ? '继续学习' : '¥' + course.price + ' 立即购买'}}</view>
        <view wx:if="{{!course.owned && course.originalPrice}}" class="purchase-original">原价 ¥{{course.originalPrice}}</view>
      </view>
    </view>
  </block>
</view>
