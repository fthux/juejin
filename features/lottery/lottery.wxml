<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="lottery-page">
  <view class="lottery-head">
    <view class="lottery-title">掘金福利限量抽</view>
    <view class="lottery-subtitle">惊喜大奖等你来拿</view>
    <view class="lottery-ore"><image src="/features/assets/app/lottery/ic_luck.webp"></image>{{ore}}</view>
    <view class="lottery-links"><text>？ 抽奖规则</text><text>▣ 我的收藏</text></view>
  </view>
  <view class="lottery-board">
    <view class="prize-grid">
      <view wx:for="{{prizes}}" wx:key="name" class="prize {{item.locked ? 'locked' : ''}}" data-name="{{item.name}}" bindtap="blocked">
        <image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
    </view>
    <view class="lottery-actions">
      <view class="lottery-action" bindtap="blocked">免费抽1次</view>
      <view class="lottery-action" bindtap="blocked">十连抽 <text>◈ 2000</text></view>
    </view>
  </view>
</view>
