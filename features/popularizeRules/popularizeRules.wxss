.rules-page {
  background: var(--jj-surface);
  color: var(--jj-text);
}

.rules-content {
  padding: 70rpx 50rpx calc(80rpx + env(safe-area-inset-bottom));
}

.rules-heading {
  margin-bottom: 58rpx;
  color: var(--jj-text);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.rule-block {
  padding: 52rpx 0;
  border-top: 1rpx solid var(--jj-line);
}

.rule-block.first {
  padding-top: 0;
  border-top: 0;
}

.question {
  margin-bottom: 34rpx;
  color: var(--jj-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.55;
}

.question.minor {
  font-size: 29rpx;
}

.answer {
  margin-top: 20rpx;
  color: var(--jj-text);
  font-size: 29rpx;
  line-height: 2;
}

.rule-image {
  width: 100%;
  margin-top: 32rpx;
  background: var(--jj-fill-2);
}

.narrow-image {
  width: 78%;
  margin-left: 11%;
}

.withdraw-image {
  width: 90%;
  margin-left: 5%;
}

.final-block {
  padding-bottom: 0;
}
