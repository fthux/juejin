.personal-info-page {
  min-height: 100vh;
  padding-top: 16rpx;
  box-sizing: border-box;
  background: var(--jj-bg);
}

.personal-info-list {
  padding: 0 30rpx;
  background: var(--jj-surface);
}

.personal-info-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--jj-line);
  color: var(--jj-text);
  font-size: 28rpx;
}

.personal-info-row:last-child {
  border-bottom: 0;
}

.arrow {
  color: var(--jj-text-4);
  font-size: 42rpx;
  font-weight: 200;
}
