.login-page { min-height: 100vh; background: var(--jj-surface); }
.login-main { padding: 96rpx 56rpx calc(42rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
.login-logo { width: 98rpx; height: 98rpx; }
.login-title { margin-top: 42rpx; color: var(--jj-text); font-size: 38rpx; font-weight: 700; text-align: center; }
.login-caption { margin-top: 22rpx; color: var(--jj-text-2); font-size: 26rpx; line-height: 1.72; text-align: center; }
.official-note { width: 100%; margin-top: 46rpx; padding: 30rpx; border-radius: 8rpx; box-sizing: border-box; background: var(--jj-fill-2); }
.note-title { color: var(--jj-text); font-size: 29rpx; font-weight: 600; }
.note-copy { margin-top: 14rpx; color: var(--jj-text-3); font-size: 24rpx; line-height: 1.65; }
.website { margin-top: 20rpx; color: var(--jj-blue); font-size: 26rpx; font-weight: 600; }
.copy-button, .back-button { padding: 0; width: 100%; height: 84rpx; margin-top: 32rpx; border-radius: 6rpx; font-size: 28rpx; line-height: 84rpx; }
.back-button { margin-top: 18rpx; color: var(--jj-text-2); background: var(--jj-fill); }
.privacy-note { margin-top: 30rpx; color: var(--jj-text-4); font-size: 22rpx; }
