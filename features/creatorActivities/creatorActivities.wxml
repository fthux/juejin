<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page activities-page">
  <view class="tabs">
    <view class="tab {{activeTab === 'article' ? 'active' : ''}}" data-id="article" bindtap="switchTab">文章活动</view>
    <view class="tab {{activeTab === 'pin' ? 'active' : ''}}" data-id="pin" bindtap="switchTab">沸点活动</view>
  </view>
  <view class="filters">
    <view bindtap="changeStatus">活动状态　<text>{{status === 'active' ? '进行中' : '已结束'}}⌄</text></view>
    <view bindtap="changeCategory">活动分类　<text>{{category === 'all' ? '全部活动' : '热门活动'}}⌄</text></view>
  </view>
  <view wx:for="{{list}}" wx:key="id" class="activity-card">
    <view class="activity-banner"><image src="{{item.image}}" mode="aspectFit"></image></view>
    <view class="activity-title">{{item.title}}</view>
    <view class="activity-copy">{{item.description}}</view>
    <view class="activity-time">{{item.time}}</view>
  </view>
  <empty-state wx:if="{{!list.length}}" text="当前筛选下没有活动"></empty-state>
  <view wx:if="{{list.length}}" class="end-line">没有更多数据了</view>
</view>
