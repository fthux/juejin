.profile-page { background: var(--jj-bg); }
.profile-head { position: relative; overflow: hidden; }
.profile-bg { width: 100%; height: 220rpx; background: var(--jj-blue-soft); }
.profile-main { margin-top: -64rpx; padding: 0 32rpx; display: flex; align-items: flex-end; }
.profile-avatar { width: 132rpx; height: 132rpx; flex: 0 0 auto; border: 6rpx solid var(--jj-surface); border-radius: 50%; background: var(--jj-fill); }
.profile-copy { min-width: 0; margin: 0 0 10rpx 22rpx; flex: 1; }
.profile-name-row { min-width: 0; display: flex; align-items: center; gap: 9rpx; }
.profile-name { max-width: 260rpx; font-size: 36rpx; font-weight: 700; }
.level-badge, .jy-badge { height: 30rpx; padding: 0 8rpx; border-radius: 4rpx; display: inline-flex; align-items: center; color: #fff; background: #557ff0; font-size: 18rpx; font-style: italic; font-weight: 700; }
.jy-badge { background: #7c55d9; }
.profile-honor { height: 40rpx; padding: 16rpx 32rpx 0; display: flex; align-items: center; color: var(--jj-blue); font-size: 26rpx; }
.profile-honor-icon { width: 40rpx; height: 40rpx; margin-right: 12rpx; flex: 0 0 auto; }
.profile-description { padding: 16rpx 32rpx 0; color: var(--jj-text-2); font-size: 26rpx; }
.profile-link { padding: 12rpx 32rpx 0; color: var(--jj-text-3); font-size: 25rpx; }
.profile-stats { padding: 26rpx 32rpx 30rpx; display: flex; align-items: center; gap: 70rpx; }
.profile-stats > view { display: flex; flex-direction: column; gap: 6rpx; color: var(--jj-text-3); font-size: 21rpx; }
.profile-stats > view text:first-child { color: var(--jj-text); font-size: 28rpx; font-weight: 600; }
.profile-actions { display: flex; gap: 12rpx; }
.profile-actions .primary-button, .profile-actions .secondary-button { min-height: 60rpx; padding: 0 22rpx; font-size: 24rpx; }
.outline-button { min-width: 120rpx; height: 58rpx; margin-bottom: 8rpx; border: 2rpx solid var(--jj-blue); border-radius: 6rpx; display: flex; align-items: center; justify-content: center; color: var(--jj-blue); font-size: 24rpx; }
.badge-strip { height: 88rpx; margin-top: 16rpx; padding: 0 28rpx; display: flex; align-items: center; box-sizing: border-box; }
.badge-copy, .badge-preview { display: flex; align-items: center; }
.badge-copy { min-width: 0; gap: 16rpx; font-size: 28rpx; }
.badge-entry-icon { width: 40rpx; height: 40rpx; flex: 0 0 auto; }
.badge-preview { min-width: 0; margin-left: auto; gap: 8rpx; }
.badge-icon { width: 56rpx; height: 56rpx; flex: 0 0 auto; }
.badge-arrow { width: 32rpx; height: 32rpx; margin-left: 4rpx; display: flex; align-items: center; justify-content: center; color: var(--jj-text-3); font-size: 36rpx; line-height: 32rpx; }
.profile-tabs { height: 88rpx; margin-top: 16rpx; padding-left: 12rpx; display: flex; align-items: stretch; border-bottom: 1rpx solid var(--jj-line); }
.profile-tab { position: relative; min-width: 103rpx; display: flex; align-items: center; justify-content: center; color: var(--jj-text-3); font-size: 27rpx; }
.profile-tab.active { color: var(--jj-blue); }
.profile-tab.active::after { content: ''; position: absolute; right: 28rpx; bottom: 0; left: 28rpx; height: 5rpx; border-radius: 3rpx; background: var(--jj-blue); }
.profile-search { margin-left: auto; padding: 0 28rpx; display: flex; align-items: center; color: var(--jj-text-3); font-size: 44rpx; }
.profile-loading { padding: 26rpx; color: var(--jj-text-3); font-size: 22rpx; text-align: center; }
