<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page profile-page">
  <view wx:if="{{user}}" class="profile-head surface">
    <image class="profile-bg" src="/features/assets/app/user/user_profile_header.png" mode="aspectFill"></image>
    <view class="profile-main">
      <image class="profile-avatar" src="{{user.avatar_large}}" mode="aspectFill"></image>
      <view class="profile-copy">
        <view class="profile-name-row">
          <view class="profile-name ellipsis">{{user.user_name}}</view>
          <text class="level-badge">LV.{{user.level || 1}}</text>
          <text class="jy-badge">JY.{{user.level || 1}}</text>
        </view>
      </view>
      <view wx:if="{{isCurrentUser}}" class="outline-button" bindtap="editProfile">编辑</view>
      <view wx:else class="profile-actions">
        <view class="secondary-button" bindtap="openChat">私信</view>
        <view class="primary-button" bindtap="toggleFollow">{{followed ? '已关注' : '关注'}}</view>
      </view>
    </view>
    <view wx:if="{{isFavorableAuthor}}" class="profile-honor">
      <image class="profile-honor-icon" src="/assets/app/user/ic_good_author.png" mode="aspectFit"></image>
      <text>优秀创作者</text>
    </view>
    <view class="profile-description">{{user.description || user.job_title || '暂无个人介绍'}}</view>
    <view wx:if="{{user.blog_address}}" class="profile-link ellipsis">{{user.blog_address}}</view>
    <view class="profile-stats">
      <view><text>{{user.followee_count || 0}}</text><text>关注</text></view>
      <view><text>{{user.follower_count || 0}}</text><text>关注者</text></view>
      <view><text>{{power}}</text><text>掘力值</text></view>
    </view>
  </view>

  <view wx:if="{{showBadges}}" class="badge-strip surface" bindtap="openBadges">
    <view class="badge-copy"><image class="badge-entry-icon" src="/assets/app/user/baged_entry_icon.png" mode="aspectFit"></image><text>获得的徽章<text wx:if="{{badgeCount}}"> {{badgeCount}}</text></text></view>
    <view class="badge-preview">
      <block wx:for="{{badges}}" wx:key="badge_id">
        <image wx:if="{{!item.hidden}}" class="badge-icon" src="{{item.image_url}}" mode="aspectFit" referrer-policy="no-referrer" data-index="{{index}}" binderror="onBadgeImageError"></image>
      </block>
      <text class="badge-arrow">›</text>
    </view>
  </view>

  <view class="profile-tabs surface">
    <view wx:for="{{tabs}}" wx:key="id" class="profile-tab {{activeTab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="switchTab">{{item.name}}</view>
    <text class="profile-search">⌕</text>
  </view>
  <view wx:if="{{activeTab === 'dynamic'}}">
    <block wx:for="{{dynamics}}" wx:key="index">
      <article-card wx:if="{{item.kind === 'article'}}" item="{{item}}" bind:open="openArticle"></article-card>
      <pin-card wx:else item="{{item}}" bind:open="openPin"></pin-card>
    </block>
    <empty-state wx:if="{{!dynamics.length}}" text="还没有发布动态"></empty-state>
  </view>
  <view wx:elif="{{activeTab === 'article'}}">
    <article-card wx:for="{{articles}}" wx:key="article_id" item="{{item}}" bind:open="openArticle"></article-card>
    <empty-state wx:if="{{!articles.length}}" text="还没有发布文章"></empty-state>
  </view>
  <view wx:elif="{{activeTab === 'pin'}}">
    <pin-card wx:for="{{pins}}" wx:key="msg_id" item="{{item}}" bind:open="openPin"></pin-card>
    <empty-state wx:if="{{!pins.length}}" text="还没有发布沸点"></empty-state>
  </view>
  <empty-state wx:else text="这里还没有内容"></empty-state>
  <view wx:if="{{articleLoading}}" class="profile-loading">正在加载更多文章...</view>
  <view wx:if="{{!articleLoading && !articleHasMore && articles.length && (activeTab === 'dynamic' || activeTab === 'article')}}" class="profile-loading">已加载全部文章</view>
</view>
