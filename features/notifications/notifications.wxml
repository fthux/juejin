<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page notice-page">
  <view class="notice-grid surface">
    <view wx:for="{{entries}}" wx:key="type" class="notice-entry {{activeType === item.type ? 'active' : ''}}" data-type="{{item.type}}" bindtap="selectType">
      <view class="notice-icon" style="background: {{item.color}}">
        {{item.mark}}
        <text wx:if="{{item.unread}}" class="badge">{{item.unread}}</text>
      </view>
      <text>{{item.title}}</text>
    </view>
  </view>
  <view class="section conversation-section">
    <view class="section-header">
      <view class="section-title">消息</view>
      <view class="section-more" bindtap="markAllRead">全部已读</view>
    </view>
    <view class="conversation" bindtap="openChat">
      <image class="avatar" src="/assets/app/common/ic_juejin_logo.webp" mode="aspectFit"></image>
      <view class="conversation-copy">
        <view class="conversation-title">掘金小助手</view>
        <view class="conversation-preview ellipsis">欢迎体验稀土掘金小程序</view>
      </view>
      <view class="conversation-time">刚刚</view>
    </view>
    <view wx:for="{{visibleNotices}}" wx:key="id" class="conversation">
      <view class="notice-dot {{item.unread ? 'unread' : ''}}"></view>
      <view class="conversation-copy">
        <view class="conversation-title">{{item.title}}</view>
        <view class="conversation-preview ellipsis">{{item.content}}</view>
      </view>
      <view class="conversation-time">{{item.displayTime}}</view>
    </view>
    <empty-state wx:if="{{activeType && !visibleNotices.length}}" text="这个分类还没有消息"></empty-state>
  </view>
</view>
