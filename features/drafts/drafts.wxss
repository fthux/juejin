.draft-head {
  height: 96rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--jj-text-3);
  font-size: 24rpx;
}

.draft-head .primary-button {
  min-height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.draft-actions { display: flex; align-items: center; gap: 18rpx; }
.draft-search { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: var(--jj-text-2); font-size: 40rpx; }

.draft-row {
  min-height: 156rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-top: 1rpx solid var(--jj-line);
}

.draft-row image {
  width: 70rpx;
  height: 70rpx;
}

.draft-copy {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.draft-title {
  font-size: 28rpx;
  font-weight: 600;
}

.draft-content,
.draft-time {
  margin-top: 7rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.draft-delete {
  padding: 16rpx;
  color: #f53f3f;
  font-size: 23rpx;
}

.draft-empty { min-height: calc(100vh - 96rpx); padding-bottom: 220rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; color: var(--jj-text-3); font-size: 25rpx; }
.draft-empty image { width: 290rpx; height: 290rpx; margin-bottom: 22rpx; }
