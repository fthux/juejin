<view class="page drafts-page">
  <view class="draft-head surface">
    <text>{{drafts.length ? '共 ' + drafts.length + ' 篇草稿' : '文章草稿'}}</text>
    <view class="draft-actions"><text class="draft-search" bindtap="search">⌕</text><view class="primary-button" bindtap="create">新建</view></view>
  </view>
  <view class="draft-list surface">
    <view wx:for="{{drafts}}" wx:key="id" class="draft-row">
      <image src="{{item.type === 'pin' ? '/features/assets/app/creator/ic_publish_pin.webp' : '/features/assets/app/creator/ic_publish_article.webp'}}" mode="aspectFit"></image>
      <view class="draft-copy">
        <view class="draft-title ellipsis">{{item.title}}</view>
        <view class="draft-content ellipsis">{{item.content}}</view>
        <view class="draft-time">{{item.displayTime}}</view>
      </view>
      <view class="draft-delete" data-id="{{item.id}}" bindtap="remove">删除</view>
    </view>
  </view>
  <view wx:if="{{!drafts.length}}" class="draft-empty surface">
    <image src="/features/assets/app/common/draft_empty.webp" mode="aspectFit"></image>
    <text>还没有任何草稿哦～</text>
  </view>
</view>
