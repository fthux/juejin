.code-page {
  min-height: 100vh;
  background: var(--jj-surface);
}

.code-main {
  padding: 140rpx 64rpx 0;
}

.code-title {
  color: var(--jj-text);
  font-size: 44rpx;
  font-weight: 700;
}

.code-caption {
  margin-top: 22rpx;
  color: var(--jj-text-2);
  font-size: 27rpx;
}

.change-mobile {
  margin-top: 14rpx;
  color: var(--jj-blue);
  font-size: 25rpx;
}

.code-field {
  height: 104rpx;
  margin-top: 72rpx;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--jj-blue);
}

.code-field.disabled {
  border-bottom-color: var(--jj-line);
}

.code-field input {
  width: 100%;
  height: 100%;
  color: var(--jj-text);
  font-size: 40rpx;
  letter-spacing: 12rpx;
}

.code-status {
  min-height: 44rpx;
  margin-top: 26rpx;
  color: var(--jj-text-3);
  font-size: 25rpx;
}

.code-status .resend {
  color: var(--jj-blue);
}

.send-error {
  margin-top: 12rpx;
  color: var(--jj-red);
  font-size: 23rpx;
  line-height: 1.5;
}
