<view class="page login-page">
  <view class="login-main">
    <image class="login-logo" src="/assets/app/common/ic_juejin_logo.webp" mode="aspectFit"></image>
    <view class="login-title">登录体验完整功能</view>
    <view class="login-caption">内容与互动状态仅保存在当前设备</view>
    <view class="nickname-field">
      <input value="{{nickname}}" maxlength="20" placeholder="输入昵称" bindinput="onNicknameInput"></input>
    </view>
    <button class="primary-button login-button" bindtap="login">进入账号</button>
    <view class="agreement" bindtap="toggleAgree">
      <view class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text>同意《用户协议》和《隐私政策》</text>
    </view>
  </view>
</view>
