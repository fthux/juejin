<view class="page login-page">
  <view class="login-main">
    <image class="login-logo" src="/assets/app/common/ic_juejin_logo.webp" mode="aspectFit"></image>
    <view class="login-title">手机号登录</view>
    <view class="login-caption">未注册手机号验证后将自动创建账号</view>

    <view class="login-form">
      <view class="login-field">
        <text class="country-code">+86</text>
        <input type="number" value="{{mobile}}" maxlength="11" placeholder="请输入手机号" focus bindinput="onMobileInput" bindconfirm="continue"></input>
      </view>
    </view>

    <button class="primary-button login-button" disabled="{{continuing}}" bindtap="continue">{{continuing ? '请稍候...' : '获取验证码'}}</button>
    <view class="agreement" bindtap="toggleAgree">
      <view class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text>已阅读并同意《用户协议》和《隐私政策》</text>
    </view>
  </view>
</view>
