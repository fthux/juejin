.column-head {
  padding: 38rpx 32rpx 30rpx;
}

.column-title {
  font-size: 40rpx;
  font-weight: 700;
}

.column-subtitle {
  margin-top: 10rpx;
  color: var(--jj-text-3);
  font-size: 24rpx;
}

.column-list {
  margin-top: 16rpx;
  background: var(--jj-surface);
}

.column-card {
  min-height: 188rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--jj-line);
}

.column-mark {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 auto;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1e80ff;
  font-size: 42rpx;
  font-weight: 700;
}

.column-copy {
  min-width: 0;
  margin-left: 22rpx;
  flex: 1;
}

.column-name {
  font-size: 30rpx;
  font-weight: 600;
}

.column-description,
.column-stats {
  margin-top: 8rpx;
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.arrow {
  margin-left: 16rpx;
  color: var(--jj-text-4);
  font-size: 46rpx;
}
