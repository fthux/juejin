.column-page { min-height: 100vh; background: var(--jj-bg); }
.plain-nav, .hero-nav { width: 100%; height: 100%; padding: 0 30rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; }
.plain-nav { background: var(--jj-surface); }
.plain-nav > text { font-size: 34rpx; font-weight: 600; }
.nav-back { width: 70rpx; font-size: 64rpx; line-height: 1; }
.nav-placeholder { width: 70rpx; }
.nav-more { font-size: 32rpx; }
.sort-bar { height: 112rpx; padding: 0 30rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; color: var(--jj-text-3); }
.sort-control { padding: 4rpx; display: flex; border-radius: 32rpx; background: var(--jj-fill); }
.sort-control view { height: 50rpx; padding: 0 22rpx; display: flex; align-items: center; border-radius: 28rpx; font-size: 23rpx; }
.sort-control .active { color: var(--jj-text); border: 1rpx solid var(--jj-text-3); background: var(--jj-surface); }
.column-list { padding: 0 30rpx; }
.column-row { min-height: 176rpx; padding: 26rpx 0; display: flex; align-items: center; box-sizing: border-box; border-bottom: 1rpx solid var(--jj-line); }
.column-copy { min-width: 0; flex: 1; }
.column-title { font-size: 31rpx; line-height: 1.5; }
.tag { margin-right: 12rpx; padding: 4rpx 10rpx; border-radius: 3rpx; color: #fff; background: #36c6a5; font-size: 21rpx; }
.column-description { margin-top: 8rpx; color: var(--jj-text-2); font-size: 23rpx; }
.column-meta { margin-top: 10rpx; color: var(--jj-text-3); font-size: 22rpx; }
.subscribe { width: 96rpx; height: 58rpx; margin-left: 20rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border: 2rpx solid var(--jj-blue); border-radius: 5rpx; color: var(--jj-blue); font-size: 24rpx; }
.detail-hero { position: relative; height: 382rpx; overflow: hidden; color: #fff; background: #181133; }
.detail-cover { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-nav { position: relative; z-index: 1; }
.detail-profile { padding: 30rpx; border-bottom: 14rpx solid var(--jj-bg); }
.detail-title { font-size: 34rpx; font-weight: 600; }
.detail-person-row { margin-top: 20rpx; display: flex; align-items: center; }
.detail-person-row > image { width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--jj-fill); }
.detail-person { min-width: 0; margin-left: 14rpx; flex: 1; }
.detail-person > view { display: flex; align-items: center; gap: 9rpx; font-size: 26rpx; }
.detail-person > text { display: block; margin-top: 5rpx; color: var(--jj-text-3); font-size: 21rpx; }
.level-badge { padding: 2rpx 8rpx; border-radius: 4rpx; color: #fff; background: #2f7de1; font-size: 17rpx; font-style: italic; font-weight: 700; }
.subscribe.filled { width: 150rpx; border-color: var(--jj-blue); color: #fff; background: var(--jj-blue); }
.subscribe.followed { border-color: var(--jj-fill); color: var(--jj-text-3); background: var(--jj-fill); }
.detail-description { margin-top: 18rpx; color: var(--jj-text-2); font-size: 24rpx; line-height: 1.5; }
.detail-stats { margin-top: 18rpx; display: flex; align-items: center; color: var(--jj-text-2); font-size: 23rpx; }
.detail-stats > text:last-child { margin-left: 14rpx; }
.subscriber-avatars { height: 44rpx; margin-right: 10rpx; display: flex; }
.subscriber-avatars image { width: 42rpx; height: 42rpx; margin-left: -10rpx; border: 2rpx solid #fff; border-radius: 50%; background: var(--jj-fill); }
.subscriber-avatars image:first-child { margin-left: 0; }
.article-bar { height: 92rpx; padding: 0 30rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--jj-line); background: var(--jj-surface); }
.article-bar > text { font-size: 31rpx; font-weight: 600; }
.article-bar > view { color: var(--jj-blue); font-size: 23rpx; }
.detail-articles { padding: 0; }
.article-row { min-height: 238rpx; padding: 28rpx 30rpx; display: flex; align-items: center; gap: 22rpx; box-sizing: border-box; border-bottom: 12rpx solid var(--jj-bg); }
.article-copy { min-width: 0; flex: 1; }
.article-title { font-size: 30rpx; font-weight: 600; line-height: 1.45; }
.article-author { margin-top: 14rpx; display: flex; align-items: center; color: var(--jj-text-3); font-size: 22rpx; }
.article-author image { width: 34rpx; height: 34rpx; margin-right: 9rpx; border-radius: 50%; }
.divider { width: 1rpx; height: 22rpx; margin: 0 12rpx; background: var(--jj-line); }
.article-brief { margin-top: 14rpx; color: var(--jj-text-2); font-size: 24rpx; line-height: 1.55; }
.article-bottom { margin-top: 17rpx; display: flex; align-items: center; justify-content: space-between; color: var(--jj-text-3); font-size: 22rpx; }
.article-actions { display: flex; gap: 32rpx; }
.article-actions > view { display: flex; align-items: center; gap: 7rpx; }
.article-actions image { width: 28rpx; height: 28rpx; }
.article-tag { padding: 5rpx 12rpx; background: var(--jj-fill); }
.article-cover { width: 164rpx; height: 124rpx; flex: 0 0 auto; border-radius: 4rpx; background: var(--jj-fill); }
.loading-line, .cache-tip, .list-end { padding: 24rpx; color: var(--jj-text-3); font-size: 22rpx; text-align: center; }
