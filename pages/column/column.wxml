<view class="page column-page">
  <block wx:if="{{mode === 'list'}}">
    <view class="sort-bar surface"><text>排序</text><view class="sort-control"><view class="{{sort === 'latest' ? 'active' : ''}}" data-id="latest" bindtap="switchSort">最新</view><view class="{{sort === 'hot' ? 'active' : ''}}" data-id="hot" bindtap="switchSort">最热</view></view></view>
    <view class="column-list surface">
      <view wx:for="{{columns}}" wx:key="column_id" class="column-row" data-index="{{index}}" bindtap="openColumn">
        <view class="column-copy"><view class="column-title two-lines"><text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>{{item.title}}</view><view wx:if="{{item.description}}" class="column-description two-lines">{{item.description}}</view><view class="column-meta">{{item.creator.user_name}} · {{item.article_count}}文章 · {{item.follower_count}}订阅</view></view>
        <view class="subscribe" catchtap="subscribe">订阅</view>
      </view>
    </view>
    <empty-state wx:if="{{!loading && !columns.length}}" text="当前暂无公开推荐专栏"></empty-state>
  </block>

  <block wx:else>
    <view wx:if="{{current}}" class="column-detail">
      <view class="detail-head surface"><view wx:if="{{current.tag}}" class="tag">{{current.tag}}</view><view class="detail-title">{{current.title}}</view><view class="detail-description">{{current.description || '系统整理优质技术内容'}}</view><view class="detail-owner" data-id="{{current.creator.user_id}}" bindtap="openCreator">{{current.creator.user_name}} · {{current.article_count}} 篇文章 · {{current.follower_count}} 订阅</view><view class="subscribe detail-subscribe" bindtap="subscribe">订阅</view></view>
      <view class="detail-articles surface"><view wx:for="{{current.articles}}" wx:key="article_id" class="article-row" data-id="{{item.article_id}}" bindtap="openArticle"><view class="article-title two-lines">{{item.title}}</view><view class="article-meta">{{item.author.user_name}} · 点赞 {{item.digg_count}} · 评论 {{item.comment_count}}</view></view></view>
      <empty-state wx:if="{{!current.articles.length}}" text="该专栏暂未返回公开文章"></empty-state>
    </view>
    <empty-state wx:elif="{{!loading}}" text="未找到这个专栏"></empty-state>
  </block>
  <view wx:if="{{loading}}" class="loading-line">正在加载专栏...</view>
  <view wx:if="{{fromCache && !loading}}" class="cache-tip">当前网络内容暂不可用</view>
</view>
