<view class="page history-page">
  <view wx:if="{{list.length}}" class="history-head surface">
    <text>最近浏览</text>
    <text class="clear" bindtap="clear">清空</text>
  </view>
  <article-card wx:for="{{list}}" wx:key="article_id" item="{{item}}" bind:open="openArticle"></article-card>
  <empty-state wx:if="{{!list.length}}" text="还没有浏览记录"></empty-state>
</view>
