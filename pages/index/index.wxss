.home-page {
  padding-bottom: 24rpx;
}

.home-head {
  width: 100%;
  height: 100%;
  padding: 0 0 0 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f2f3f5;
}

.brand,
.head-actions,
.category-row,
.sorts {
  display: flex;
  align-items: center;
}

.brand image {
  width: 46rpx;
  height: 46rpx;
  margin-right: 14rpx;
}

.brand text {
  color: #1e80ff;
  font-size: 34rpx;
  font-weight: 700;
}

.head-actions {
  gap: 12rpx;
}

.icon-button {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-2);
  font-size: 35rpx;
}

.search-button {
  font-size: 46rpx;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-row {
  height: 78rpx;
  padding: 0 16rpx;
}

.category {
  position: relative;
  height: 78rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  color: var(--jj-text-2);
  font-size: 27rpx;
}

.category.active {
  color: #1e80ff;
  font-weight: 600;
}

.category.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 30rpx;
  height: 4rpx;
  background: #1e80ff;
  transform: translateX(-50%);
}

.login-guide {
  margin: 16rpx 0;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--jj-surface);
}

.guide-title {
  font-size: 28rpx;
  font-weight: 600;
}

.guide-copy {
  margin-top: 8rpx;
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.login-guide .secondary-button {
  min-height: 60rpx;
}

.feed-head {
  height: 78rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--jj-line);
}

.sorts {
  gap: 36rpx;
}

.sort {
  color: var(--jj-text-3);
  font-size: 25rpx;
}

.sort.active {
  color: var(--jj-text);
  font-weight: 600;
}

.offline-mark {
  color: var(--jj-text-3);
  font-size: 22rpx;
}
