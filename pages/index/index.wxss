.home-page {
  padding-bottom: 24rpx;
}

.home-head {
  width: 100%;
  height: 100%;
  padding: 0 20rpx 0 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.home-search {
  min-width: 0;
  height: 66rpx;
  padding: 0 18rpx;
  flex: 1;
  display: flex;
  align-items: center;
  border-radius: 6rpx;
  box-sizing: border-box;
  color: var(--jj-text-3);
  background: var(--jj-fill);
  font-size: 22rpx;
}

.home-search image {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
}

.calendar-entry {
  width: 68rpx;
  height: 70rpx;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--jj-blue);
  font-size: 17rpx;
  line-height: 1;
}

.calendar-icon {
  position: relative;
  width: 40rpx;
  height: 34rpx;
  margin-bottom: 4rpx;
  border: 3rpx solid var(--jj-text-3);
  border-radius: 5rpx;
  color: var(--jj-blue);
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.calendar-icon::before,
.calendar-icon::after {
  content: "";
  position: absolute;
  top: -8rpx;
  width: 4rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: var(--jj-text-3);
}

.calendar-icon::before { left: 8rpx; }
.calendar-icon::after { right: 8rpx; }

.calendar-icon text {
  display: block;
}

.nav-scroll {
  width: 100%;
  border-bottom: 1rpx solid var(--jj-line);
  white-space: nowrap;
}

.nav-row {
  height: 78rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: stretch;
}

.nav-item {
  position: relative;
  min-width: 86rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-3);
  font-size: 25rpx;
}

.nav-item.active {
  color: var(--jj-text);
  font-weight: 600;
}

.nav-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 32rpx;
  height: 4rpx;
  background: var(--jj-blue);
  transform: translateX(-50%);
}

.nav-menu {
  width: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-3);
  font-size: 28rpx;
}

.hot-section {
  padding: 18rpx 24rpx 20rpx;
  border-bottom: 12rpx solid var(--jj-bg);
}

.hot-heading {
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hot-title {
  font-size: 28rpx;
  font-weight: 700;
}

.hot-type {
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  color: var(--jj-blue);
  background: var(--jj-blue-soft);
  font-size: 20rpx;
}

.hot-row {
  height: 52rpx;
  display: flex;
  align-items: center;
}

.hot-rank {
  width: 42rpx;
  color: #ff9f1a;
  font-size: 24rpx;
  font-weight: 700;
}

.hot-rank.rank-1 { color: #f53f3f; }
.hot-rank.rank-2 { color: #ff7d00; }

.hot-name {
  min-width: 0;
  flex: 1;
  font-size: 23rpx;
}

.hot-value {
  margin-left: 16rpx;
  color: var(--jj-text-3);
  font-size: 19rpx;
}

.hot-dots {
  height: 22rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 14rpx;
}

.hot-dots text {
  width: 22rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--jj-line);
}

.hot-dots text.active {
  background: var(--jj-blue);
}

.cache-note {
  color: var(--jj-text-3);
  font-size: 20rpx;
  text-align: center;
}
