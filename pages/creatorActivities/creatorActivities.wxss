.activities-page {
  background: var(--jj-bg);
}

.activities-page .tab {
  flex: 1;
}

.filters {
  min-height: 90rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--jj-surface);
  color: var(--jj-text-3);
  font-size: 24rpx;
}

.filters text {
  color: var(--jj-blue);
}

.activity-card {
  margin-top: 16rpx;
  padding: 30rpx;
  background: var(--jj-surface);
}

.activity-banner {
  width: 100%;
  aspect-ratio: 3.32 / 1;
  overflow: hidden;
  border-radius: 6rpx;
  background: #ffffff;
}

.activity-banner image { width: 100%; height: 100%; }

.activity-title {
  margin-top: 24rpx;
  color: var(--jj-text);
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}

.activity-copy,
.activity-time,
.end-line {
  margin-top: 14rpx;
  color: var(--jj-text-3);
}

.activity-time {
  font-size: 22rpx;
}

.end-line {
  padding: 34rpx;
  text-align: center;
}
