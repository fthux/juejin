.activities-page {
  background: var(--jj-bg);
}

.activities-page .tab {
  flex: 1;
}

.filters {
  min-height: 90rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--jj-surface);
  color: var(--jj-text-3);
  font-size: 24rpx;
}

.filters text {
  color: var(--jj-blue);
}

.activity-card {
  margin-top: 16rpx;
  padding: 30rpx;
  background: var(--jj-surface);
}

.activity-card image {
  width: 100%;
  height: 230rpx;
  border-radius: 6rpx;
}

.activity-title {
  margin-top: 24rpx;
  color: var(--jj-text);
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}

.activity-copy,
.activity-time,
.end-line {
  margin-top: 14rpx;
  color: var(--jj-text-3);
}

.activity-footer {
  min-height: 72rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.activity-time {
  font-size: 22rpx;
}

.register-button {
  width: 152rpx;
  height: 64rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border-radius: 4rpx;
  color: #ffffff;
  background: var(--jj-blue);
  font-size: 24rpx;
  line-height: 64rpx;
}

.register-button.registered {
  color: var(--jj-blue);
  background: var(--jj-blue-soft);
}

.end-line {
  padding: 34rpx;
  text-align: center;
}
