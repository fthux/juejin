.activities-page { background: var(--jj-bg); }.activities-page .tab { flex: 1; }.filters { min-height: 90rpx; padding: 0 30rpx; display: flex; align-items: center; justify-content: space-between; background: var(--jj-surface); color: var(--jj-text-3); }.filters text { color: var(--jj-blue); }.activity-card { padding: 30rpx; background: var(--jj-surface); }.activity-card image { width: 100%; height: 230rpx; border-radius: 6rpx; }.activity-title { margin-top: 24rpx; color: var(--jj-text); font-size: 31rpx; font-weight: 600; line-height: 1.5; }.activity-copy,.activity-time,.end-line { margin-top: 14rpx; color: var(--jj-text-3); }.end-line { padding: 34rpx; text-align: center; }
