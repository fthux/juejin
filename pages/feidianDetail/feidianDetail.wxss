.pin-detail-page { padding-bottom: 112rpx; background: var(--jj-bg); }

.detail-navigation {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid var(--jj-line);
  box-sizing: border-box;
}

.detail-title { color: var(--jj-text); font-size: 30rpx; font-weight: 600; }
.detail-back, .detail-more { position: absolute; top: 0; height: 100%; display: flex; align-items: center; color: var(--jj-text); }
.detail-back { left: 22rpx; width: 64rpx; font-size: 62rpx; font-weight: 200; }
.detail-more { right: 16rpx; padding: 0 18rpx; color: var(--jj-text-2); font-size: 24rpx; }

.recommend-section { margin-top: 14rpx; padding: 26rpx 0 24rpx; }
.recommend-title { padding: 0 28rpx; color: var(--jj-text); font-size: 28rpx; font-weight: 600; }
.recommend-scroll { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.recommend-card { width: 330rpx; min-height: 166rpx; margin-left: 18rpx; padding: 18rpx; display: inline-flex; flex-direction: column; vertical-align: top; box-sizing: border-box; border-radius: 5rpx; background: var(--jj-fill); white-space: normal; }
.recommend-card:last-child { margin-right: 18rpx; }
.recommend-topic { color: var(--jj-blue); font-size: 22rpx; }
.recommend-content { min-height: 68rpx; margin-top: 10rpx; color: var(--jj-text); font-size: 24rpx; line-height: 1.45; }
.recommend-meta { margin-top: 12rpx; color: var(--jj-text-3); font-size: 19rpx; }

.comments { margin-top: 14rpx; }
.section-title text { margin-left: 10rpx; color: var(--jj-text-3); font-size: 23rpx; font-weight: 400; }
.comment-row { padding: 26rpx 30rpx; display: flex; border-top: 1rpx solid var(--jj-line); }
.comment-row .avatar { width: 64rpx; height: 64rpx; }
.comment-body { min-width: 0; margin-left: 18rpx; flex: 1; }
.comment-user { color: var(--jj-text-2); font-size: 24rpx; }
.comment-content { margin-top: 10rpx; color: var(--jj-text); font-size: 27rpx; line-height: 1.55; word-break: break-all; }
.comment-foot { margin-top: 13rpx; display: flex; align-items: center; justify-content: space-between; color: var(--jj-text-3); font-size: 21rpx; }
.comment-empty { padding: 70rpx 20rpx; color: var(--jj-text-3); text-align: center; font-size: 24rpx; }

.comment-bar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; min-height: 100rpx; padding: 14rpx 22rpx; display: flex; align-items: center; gap: 22rpx; box-sizing: border-box; background: var(--jj-surface); border-top: 1rpx solid var(--jj-line); }
.comment-input { height: 62rpx; padding: 0 22rpx; display: flex; align-items: center; flex: 1; border-radius: 31rpx; color: var(--jj-text-3); background: var(--jj-fill); font-size: 23rpx; }
.bottom-action { min-width: 54rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--jj-text-3); font-size: 18rpx; }
.like-icon, .comment-icon { color: var(--jj-text-2); font-size: 34rpx; line-height: 1; }
