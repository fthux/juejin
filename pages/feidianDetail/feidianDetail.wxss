.pin-detail-page {
  padding-bottom: 108rpx;
}

.comments {
  margin-top: 0;
}

.comment-row {
  padding: 26rpx 32rpx;
  display: flex;
  border-top: 1rpx solid var(--jj-line);
}

.comment-row .avatar {
  width: 64rpx;
  height: 64rpx;
}

.comment-body {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
}

.comment-user {
  color: var(--jj-text-2);
  font-size: 25rpx;
}

.comment-content {
  margin-top: 10rpx;
  color: var(--jj-text);
  font-size: 28rpx;
  line-height: 1.55;
}

.comment-time {
  margin-top: 12rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.comment-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 100rpx;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  border-top: 1rpx solid var(--jj-line);
}

.comment-input {
  height: 64rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  flex: 1;
  border-radius: 6rpx;
  color: var(--jj-text-3);
  background: var(--jj-fill);
}

.share-button {
  width: 100rpx;
  height: 64rpx;
  padding: 0;
  color: #1e80ff;
  background: transparent;
  font-size: 25rpx;
  line-height: 64rpx;
}
