.pin-page {
  padding-bottom: 26rpx;
}

.pin-page.following-mode {
  --jj-surface: #ffffff;
  --jj-bg: #ffffff;
  --jj-text: #252933;
  --jj-text-2: #515767;
  --jj-text-3: #8a919f;
  --jj-line: #e5e6eb;
  padding-bottom: 0;
  background: #ffffff;
}

.pin-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  background: var(--jj-surface);
}

.pin-navigation {
  width: 100vw;
  height: 100%;
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 72rpx;
}

.top-tab {
  position: relative;
  min-width: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-2);
  font-size: 29rpx;
}

.top-tab.active {
  color: var(--jj-blue);
  font-weight: 600;
}

.top-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--jj-blue);
  transform: translateX(-50%);
}

.topic-section {
  padding: 24rpx 0 22rpx;
  border-top: 1rpx solid var(--jj-line);
}

.block-title {
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.topic-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.joined-topics {
  padding-right: 24rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.topic-scroll,
.selected-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.topic-scroll {
  margin-top: 12rpx;
  padding-top: 8rpx;
  box-sizing: border-box;
}

.topic-item {
  position: relative;
  width: 126rpx;
  margin-left: 14rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  vertical-align: top;
}

.topic-item:last-child {
  margin-right: 18rpx;
}

.topic-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jj-blue);
  background: var(--jj-blue-soft);
  font-size: 24rpx;
  font-weight: 700;
}

.topic-icon image {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.discover-more {
  color: #ffffff;
  background: var(--jj-blue);
  font-size: 38rpx;
}

.topic-name {
  width: 100%;
  margin-top: 10rpx;
  color: var(--jj-text-2);
  font-size: 21rpx;
  text-align: center;
}

.topic-badge {
  position: absolute;
  top: -8rpx;
  right: 7rpx;
  min-width: 38rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border: 3rpx solid var(--jj-surface);
  border-radius: 17rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #4e5969;
  font-size: 16rpx;
  line-height: 24rpx;
  text-align: center;
}

.sort-row {
  height: 82rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid var(--jj-line);
}

.sort-label {
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.sort-switch {
  padding: 4rpx;
  display: flex;
  border-radius: 30rpx;
  background: var(--jj-fill);
}

.sort-switch view {
  height: 46rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border-radius: 25rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.sort-switch view.active {
  color: var(--jj-text);
  border: 1rpx solid var(--jj-text-3);
  background: var(--jj-surface);
}

.selected-section {
  padding: 24rpx 0 20rpx;
  border-bottom: 14rpx solid var(--jj-bg);
}

.selected-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.selected-more {
  padding-right: 24rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.selected-pin {
  width: 310rpx;
  height: 104rpx;
  margin-left: 18rpx;
  padding: 16rpx;
  display: inline-flex;
  flex-direction: column;
  vertical-align: top;
  box-sizing: border-box;
  border-radius: 4rpx;
  background: var(--jj-fill);
  white-space: normal;
}

.selected-pin:last-child {
  margin-right: 18rpx;
}

.selected-pin-title {
  color: var(--jj-blue);
  font-size: 22rpx;
}

.selected-pin-title text {
  margin-right: 8rpx;
  padding: 3rpx 6rpx;
  border-radius: 3rpx;
  color: #ffffff;
  background: var(--jj-blue);
  font-size: 17rpx;
}

.selected-actions {
  margin-top: 12rpx;
  color: var(--jj-text-3);
  font-size: 18rpx;
}

.cache-note {
  color: var(--jj-text-3);
  font-size: 20rpx;
  text-align: center;
}

.following-login {
  min-height: calc(100vh - 128rpx);
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #ffffff;
}

.following-illustration {
  width: 230rpx;
  height: 230rpx;
}

.following-title {
  margin-top: 30rpx;
  color: var(--jj-text-2);
  font-size: 27rpx;
}

.following-button {
  width: 220rpx;
  height: 68rpx;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 5rpx;
  color: #ffffff;
  background: var(--jj-blue);
  font-size: 27rpx;
}

.publish-fab {
  position: fixed;
  z-index: 8;
  right: 34rpx;
  bottom: 148rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: var(--jj-blue);
  box-shadow: 0 10rpx 28rpx rgba(30, 128, 255, 0.3);
  font-size: 42rpx;
}

.publish-fab text {
  display: block;
  transform: translateY(-2rpx);
}
