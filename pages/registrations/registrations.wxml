<view class="page registrations-page">
  <view wx:for="{{list}}" wx:key="id" class="registration-card">
    <image src="{{item.image}}" mode="aspectFill"></image>
    <view class="registration-body">
      <view class="registration-title two-lines">{{item.title}}</view>
      <view class="registration-time">{{item.time}}</view>
      <view class="registration-status">报名成功</view>
    </view>
    <button class="cancel-button" data-id="{{item.id}}" bindtap="cancel">取消</button>
  </view>
  <view wx:if="{{!list.length}}" class="empty-registration">
    <image src="/assets/app/common/ic_yoyo_empty.webp" mode="aspectFit"></image>
    <text>你还没有任何报名哦~</text>
  </view>
</view>
