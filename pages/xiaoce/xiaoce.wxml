<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page course-page">
  <status-bar navigation="{{true}}">
    <view class="course-header surface">
      <view class="course-type-tabs">
        <view wx:for="{{courseTypes}}" wx:key="id" class="course-type {{activeCourseType === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCourseType">
          <text>{{item.name}}</text><text wx:if="{{item.badge}}" class="vip-free">{{item.badge}}</text>
        </view>
      </view>
      <view class="course-actions">
        <image class="course-action" src="/assets/app/user/ic_user_course.png" mode="aspectFit" bindtap="openCourseCenter"></image>
      </view>
    </view>
  </status-bar>

  <scroll-view class="category-scroll surface {{activeCourseType === 'byte' ? 'byte' : ''}}" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-row">
      <view wx:for="{{categories}}" wx:key="id" class="category {{activeCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{activeCourseType === 'booklet'}}" class="course-filters surface">
    <view class="sort-row">
      <view wx:for="{{sorts}}" wx:key="id" class="sort-item {{activeSort === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectSort">
        <text>{{item.name}}</text>
        <view wx:if="{{item.id === 'price'}}" class="sort-arrows {{priceDirection}}"><text>▲</text><text>▼</text></view>
      </view>
    </view>
    <view class="vip-filter {{onlyVip ? 'active' : ''}}" bindtap="toggleVip"><text class="vip-check">{{onlyVip ? '✓' : ''}}</text><text>只看 VIP 课程</text></view>
  </view>

  <view wx:if="{{activeCourseType === 'byte'}}" class="byte-course-list surface">
    <byte-course-card wx:for="{{list}}" wx:key="id" item="{{item}}" bind:open="openCourse"></byte-course-card>
  </view>
  <view wx:else class="course-list surface">
    <course-card wx:for="{{list}}" wx:key="id" item="{{item}}" bind:open="openCourse"></course-card>
  </view>
  <empty-state wx:if="{{!loading && !list.length}}" text="{{loadError ? '课程暂时无法加载' : '这里还没有课程'}}"></empty-state>
  <view wx:if="{{loading}}" class="loading-line">正在加载课程...</view>
  <view wx:elif="{{list.length && !hasMore}}" class="loading-line">没有更多了</view>
</view>
