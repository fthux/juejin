.course-header {
  width: 100%;
  height: 100%;
  padding: 0 0 0 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-title {
  font-size: 38rpx;
  font-weight: 700;
}

.course-search {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-2);
  font-size: 44rpx;
}

.vip-banner {
  min-height: 142rpx;
  margin: 16rpx 24rpx;
  padding: 26rpx 30rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: #f6d7a6;
  background: #252933;
}

.vip-title {
  color: #fff3d6;
  font-size: 32rpx;
  font-weight: 700;
}

.vip-copy {
  margin-top: 9rpx;
  font-size: 23rpx;
}

.vip-arrow {
  font-size: 24rpx;
}
