.course-header {
  width: 100%;
  height: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-title {
  position: absolute;
  left: 50%;
  color: var(--jj-text);
  font-size: 30rpx;
  font-weight: 600;
  transform: translateX(-50%);
}

.course-action {
  width: 52rpx;
  height: 52rpx;
}

.category-scroll {
  width: 100%;
  border-bottom: 1rpx solid var(--jj-line);
}

.category-row {
  width: auto;
  height: 78rpx;
  padding: 0 30rpx;
  display: inline-flex;
  align-items: center;
  gap: 42rpx;
  box-sizing: border-box;
}

.category {
  color: var(--jj-text-3);
  font-size: 27rpx;
  white-space: nowrap;
}

.category.active {
  color: var(--jj-blue);
  font-weight: 600;
}

.course-filters {
  height: 82rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-bottom: 1rpx solid var(--jj-line);
  box-sizing: border-box;
}

.sort-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sort-item {
  display: flex;
  align-items: center;
  gap: 5rpx;
  color: var(--jj-text-3);
  font-size: 26rpx;
}

.sort-item.active {
  color: var(--jj-blue);
  font-weight: 600;
}

.sort-arrows {
  display: flex;
  flex-direction: column;
  color: var(--jj-text-4);
  font-size: 11rpx;
  line-height: 0.9;
}

.sort-arrows.asc text:first-child,
.sort-arrows.desc text:last-child {
  color: var(--jj-blue);
}

.course-list {
  min-height: 400rpx;
}
