.course-header {
  width: 100%;
  height: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-type-tabs {
  min-width: 0;
  display: flex;
  align-items: stretch;
  gap: 28rpx;
  align-self: stretch;
}

.course-type {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--jj-text-3);
  font-size: 25rpx;
  white-space: nowrap;
}

.course-type.active {
  color: var(--jj-text);
  font-size: 29rpx;
  font-weight: 700;
}

.course-type.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 30rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--jj-blue);
  transform: translateX(-50%);
}

.vip-free {
  padding: 4rpx 8rpx;
  border-radius: 5rpx;
  color: #72531f;
  background: #f7e5bf;
  font-size: 16rpx;
  font-weight: 500;
}

.course-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.course-action {
  width: 52rpx;
  height: 52rpx;
}

.category-scroll {
  width: 100%;
  border-bottom: 1rpx solid var(--jj-line);
}

.category-row {
  width: auto;
  height: 78rpx;
  padding: 0 30rpx;
  display: inline-flex;
  align-items: center;
  gap: 42rpx;
  box-sizing: border-box;
}

.category {
  color: var(--jj-text-3);
  font-size: 27rpx;
  white-space: nowrap;
}

.category.active {
  color: var(--jj-blue);
  font-weight: 600;
}

.course-filters {
  min-height: 82rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--jj-line);
  box-sizing: border-box;
}

.sort-row {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 34rpx;
}

.vip-filter {
  margin-left: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--jj-text-3);
  font-size: 21rpx;
  white-space: nowrap;
}

.vip-check {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid var(--jj-text-4);
  border-radius: 4rpx;
  color: #ffffff;
  line-height: 27rpx;
  text-align: center;
  box-sizing: border-box;
}

.vip-filter.active {
  color: var(--jj-blue);
}

.vip-filter.active .vip-check {
  border-color: var(--jj-blue);
  background: var(--jj-blue);
}

.sort-item {
  display: flex;
  align-items: center;
  gap: 5rpx;
  color: var(--jj-text-3);
  font-size: 26rpx;
}

.sort-item.active {
  color: var(--jj-blue);
  font-weight: 600;
}

.sort-arrows {
  display: flex;
  flex-direction: column;
  color: var(--jj-text-4);
  font-size: 11rpx;
  line-height: 0.9;
}

.sort-arrows.asc text:first-child,
.sort-arrows.desc text:last-child {
  color: var(--jj-blue);
}

.course-list {
  min-height: 400rpx;
}
