.find-page { padding-bottom: 30rpx; }
.find-top { padding: 0 24rpx 14rpx; background: var(--jj-surface) url('/assets/app/find/find_page_bg_top.webp') center top / 100% auto no-repeat; }
.search-bar { height: 76rpx; margin: 12rpx 0 28rpx; padding: 0 22rpx; display: flex; align-items: center; box-sizing: border-box; border: 1rpx solid var(--jj-line); border-radius: 6rpx; color: var(--jj-text-3); background: var(--jj-surface); }
.search-bar image { width: 34rpx; height: 34rpx; margin-right: 16rpx; }
.channel-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.channel-item { min-width: 0; height: 118rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid var(--jj-line); border-radius: 6rpx; box-sizing: border-box; background: var(--jj-surface); color: var(--jj-text-2); font-size: 22rpx; }
.channel-item image { width: 48rpx; height: 48rpx; margin-bottom: 10rpx; }
.quick-swiper { height: 164rpx; margin-top: 12rpx; }
.quick-grid { height: 132rpx; display: grid; grid-template-columns: repeat(5, 1fr); align-items: center; }
.quick-item { min-width: 0; display: flex; flex-direction: column; align-items: center; color: var(--jj-text-2); font-size: 23rpx; }
.quick-item image { width: 72rpx; height: 72rpx; margin-bottom: 8rpx; }
.find-banner { position: relative; height: 198rpx; margin: 16rpx 24rpx 0; overflow: hidden; border-radius: 8rpx; background: var(--jj-surface); }
.find-banner image { width: 100%; height: 100%; }
.find-banner swiper-item { position: relative; }
.banner-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0, 0, 0, .58), rgba(0, 0, 0, .08)); }
.banner-copy { position: absolute; left: 28rpx; top: 28rpx; width: 58%; color: #fff; }
.banner-copy view { font-size: 31rpx; font-weight: 700; }
.banner-copy text { margin-top: 12rpx; font-size: 21rpx; line-height: 1.5; }
.daily-card { margin: 16rpx 24rpx 0; border-radius: 8rpx; background: var(--jj-surface); }
.daily-card { min-height: 284rpx; padding: 24rpx; box-sizing: border-box; }
.daily-heading, .discover-heading { display: flex; align-items: center; justify-content: space-between; }
.daily-heading > image { width: 208rpx; height: 56rpx; }
.daily-heading > view, .discover-heading > view { color: var(--jj-text-3); font-size: 23rpx; font-weight: 400; }
.daily-content { margin-top: 18rpx; display: flex; align-items: center; }
.calendar { width: 142rpx; height: 154rpx; flex: 0 0 auto; }
.daily-copy { min-width: 0; margin-left: 22rpx; flex: 1; }
.daily-title { font-size: 29rpx; font-weight: 600; line-height: 1.45; }
.daily-brief { margin-top: 12rpx; color: var(--jj-text-3); font-size: 23rpx; line-height: 1.48; }
.discover-section { margin-top: 24rpx; padding-bottom: 24rpx; overflow: hidden; background: transparent; }
.discover-heading { height: 94rpx; padding: 0 30rpx; font-size: 31rpx; font-weight: 700; }
.horizontal-scroll { width: 100%; white-space: nowrap; }
.horizontal-card { width: 520rpx; min-height: 272rpx; margin-left: 18rpx; padding: 22rpx; display: inline-flex; position: relative; vertical-align: top; flex-direction: column; box-sizing: border-box; border: 1rpx solid var(--jj-line); border-radius: 7rpx; white-space: normal; }
.horizontal-card:last-child { margin-right: 18rpx; }
.selected-pin { width: 602rpx; min-height: 310rpx; }
.selected-pin-head, .collection-top { display: flex; align-items: center; }
.selected-avatar { width: 64rpx; height: 64rpx; flex: 0 0 auto; border-radius: 50%; }
.selected-identity { min-width: 0; margin-left: 14rpx; flex: 1; }
.selected-name { font-size: 26rpx; font-weight: 600; }
.selected-caption { margin-top: 5rpx; color: var(--jj-text-3); font-size: 20rpx; }
.outline-action, .fill-action { min-width: 88rpx; height: 52rpx; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 4rpx; font-size: 22rpx; }
.outline-action { border: 1rpx solid var(--jj-blue); color: var(--jj-blue); }
.fill-action { color: #fff; background: var(--jj-blue); }
.selected-content { margin-top: 20rpx; flex: 1; color: var(--jj-text-2); font-size: 26rpx; line-height: 1.58; }
.four-lines { display: -webkit-box; overflow: hidden; text-overflow: ellipsis; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
.selected-actions { margin-top: 20rpx; display: flex; gap: 34rpx; color: var(--jj-text-3); font-size: 21rpx; }
.topic-card { width: 300rpx; min-height: 314rpx; align-items: center; text-align: center; }
.topic-icon { width: 86rpx; height: 86rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 6rpx; color: var(--jj-blue); background: var(--jj-blue-soft); font-size: 22rpx; font-weight: 700; }
.topic-icon image { width: 100%; height: 100%; }
.topic-name { width: 100%; margin-top: 16rpx; font-weight: 600; }
.topic-stats { width: 100%; margin: 10rpx 0 20rpx; color: var(--jj-text-3); font-size: 20rpx; }
.topic-card .fill-action, .author-card .fill-action { margin-top: auto; }
.column-card, .collection-card { width: 676rpx; min-height: 650rpx; padding: 0; overflow: hidden; }
.recommend-card-head { min-height: 136rpx; padding: 26rpx; display: flex; align-items: flex-start; justify-content: space-between; box-sizing: border-box; background: linear-gradient(100deg, var(--jj-fill), var(--jj-surface)); }
.column-cover { width: 94rpx; height: 94rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 6rpx; color: var(--jj-blue); background: var(--jj-blue-soft); font-weight: 700; }
.column-cover image { width: 100%; height: 100%; }
.card-title { margin-top: 18rpx; color: var(--jj-text); font-size: 28rpx; font-weight: 600; line-height: 1.45; }
.card-meta { margin-top: 10rpx; color: var(--jj-text-3); font-size: 21rpx; }
.column-card > .card-title, .column-card > .card-meta, .collection-card > .card-title, .collection-card > .card-meta { margin-left: 26rpx; margin-right: 26rpx; }
.collection-top { min-height: 112rpx; padding: 22rpx 26rpx; justify-content: space-between; box-sizing: border-box; background: linear-gradient(100deg, var(--jj-fill), var(--jj-surface)); }
.collection-mark { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 5rpx; color: #fff; background: #3b82f6; font-size: 24rpx; font-weight: 700; }
.recommend-preview { margin-top: 24rpx; padding: 0 26rpx; border-top: 1rpx solid var(--jj-line); }
.preview-row { padding: 16rpx 0; }
.preview-row > view { font-size: 25rpx; }
.preview-row text { display: block; margin-top: 7rpx; color: var(--jj-text-3); font-size: 20rpx; }
.recommend-footer { height: 74rpx; margin: auto 26rpx 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 5rpx; color: var(--jj-text-2); background: var(--jj-fill); font-size: 24rpx; }
.author-card { width: 300rpx; min-height: 342rpx; align-items: center; text-align: center; }
.author-avatar { width: 102rpx; height: 102rpx; border-radius: 50%; background: var(--jj-fill); }
.author-card .card-title { width: 100%; }
.author-card .card-meta { width: 100%; }
.author-stats { margin: 10rpx 0 18rpx; color: var(--jj-text-3); font-size: 19rpx; }
.article-rank-section, .industry-section { padding: 0 30rpx 20rpx; box-sizing: border-box; background: var(--jj-surface); }
.article-rank-section .discover-heading, .industry-section .discover-heading { padding: 0; }
.rank-chips { width: 100%; margin-bottom: 8rpx; white-space: nowrap; }
.rank-chip { height: 52rpx; margin-right: 12rpx; padding: 0 20rpx; display: inline-flex; align-items: center; border-radius: 4rpx; color: var(--jj-text-2); background: var(--jj-fill); font-size: 22rpx; }
.rank-chip.active { color: var(--jj-blue); background: var(--jj-blue-soft); }
.rank-row { min-height: 132rpx; display: flex; align-items: center; border-bottom: 1rpx solid var(--jj-line); }
.rank-index { width: 54rpx; color: var(--jj-text-3); font-size: 27rpx; font-weight: 700; text-align: center; }
.rank-index.rank-1 { color: #f53f3f; }.rank-index.rank-2 { color: #ff7d00; }.rank-index.rank-3 { color: #f7ba1e; }
.rank-copy { min-width: 0; padding: 18rpx 0; flex: 1; }
.rank-title { font-size: 27rpx; font-weight: 600; line-height: 1.45; }
.headline-row { min-height: 208rpx; padding: 24rpx 0; display: flex; align-items: center; border-bottom: 1rpx solid var(--jj-line); box-sizing: border-box; }
.headline-copy { min-width: 0; flex: 1; }
.headline-brief { margin-top: 12rpx; color: var(--jj-text-2); font-size: 22rpx; line-height: 1.45; }
.headline-row image { width: 172rpx; height: 128rpx; margin-left: 20rpx; flex: 0 0 auto; border-radius: 4rpx; background: var(--jj-fill); }
.cache-note { padding: 22rpx 0 0; color: var(--jj-text-3); font-size: 21rpx; text-align: center; }
@media (prefers-color-scheme: dark) { .find-top { background-image: url('/assets/app/find/dark/find_page_bg_top.webp'); } }
