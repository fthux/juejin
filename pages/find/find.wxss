.find-page {
  min-height: 100vh;
  padding-bottom: calc(var(--jj-tabbar-height) + 30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--jj-tabbar-height) + 30rpx + env(safe-area-inset-bottom));
  background: var(--jj-surface);
}
.find-sticky { position: sticky; top: 0; z-index: 20; width: 100%; overflow: hidden; background: #eef8fc; }
.find-sticky-bg, .find-top-bg { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; }
.find-sticky-content, .find-top-content { position: relative; z-index: 1; }
.find-search-head { width: 100%; height: 100%; padding: 0 24rpx; display: flex; align-items: center; box-sizing: border-box; }
.search-bar { width: 100%; height: 66rpx; padding: 0 22rpx; display: flex; align-items: center; box-sizing: border-box; border-radius: 5rpx; color: var(--jj-text-3); background: var(--jj-surface); box-shadow: 0 2rpx 10rpx rgba(32, 61, 94, .04); }
.search-bar image { width: 34rpx; height: 34rpx; margin-right: 14rpx; }
.find-top { position: relative; padding: 20rpx 24rpx 12rpx; overflow: hidden; background: #eef8fc; }
.channel-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14rpx; }
.channel-item { height: 112rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(229, 230, 235, .8); border-radius: 5rpx; box-sizing: border-box; color: var(--jj-text-2); background: var(--jj-surface); box-shadow: 0 4rpx 16rpx rgba(35, 65, 95, .05); font-size: var(--jj-font-caption); }
.channel-item image { width: 43rpx; height: 43rpx; margin-bottom: 9rpx; }
.quick-swiper { width: 100%; height: 166rpx; }
.quick-grid { height: 142rpx; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); align-items: center; }
.quick-item { min-width: 0; min-height: var(--jj-touch-target); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--jj-text-2); font-size: var(--jj-font-caption); }
.quick-item image { width: 68rpx; height: 68rpx; margin-bottom: 8rpx; }
.find-banner { position: relative; height: 198rpx; margin: 16rpx 24rpx 0; overflow: hidden; border-radius: 6rpx; background: var(--jj-fill-2); }
.find-banner swiper-item { position: relative; overflow: hidden; background: var(--jj-fill-2); }
.banner-art { position: absolute; top: 0; right: 0; width: 198rpx; height: 198rpx; }
.banner-copy { position: absolute; left: 26rpx; top: 31rpx; z-index: 2; width: calc(100% - 230rpx); color: var(--jj-text); }
.banner-copy view { font-size: 31rpx; font-weight: 700; }
.banner-brief { max-height: 72rpx; margin-top: 12rpx; color: var(--jj-text-2); font-size: var(--jj-font-caption); line-height: 36rpx; white-space: normal; word-break: break-all; }
.default-banner-image { width: 100%; height: 100%; }
.daily-card { min-height: 260rpx; margin: 16rpx 24rpx 0; padding: 22rpx 24rpx; box-sizing: border-box; border: 1rpx solid var(--jj-line); border-radius: 7rpx; background: #f3f9ff; }
.daily-heading, .discover-heading { display: flex; align-items: center; justify-content: space-between; }
.daily-heading > image { width: 222rpx; height: 54rpx; }
.daily-heading > view, .discover-heading > view { min-height: 64rpx; display: flex; align-items: center; color: var(--jj-text-3); font-size: var(--jj-font-caption); font-weight: 400; }
.daily-heading > view text { color: var(--jj-blue); font-size: 28rpx; }
.daily-content { margin-top: 15rpx; display: flex; align-items: center; }
.calendar-wrap { position: relative; width: 138rpx; height: 142rpx; flex: 0 0 auto; color: #fff; text-align: center; }
.calendar { width: 138rpx; height: 142rpx; }
.calendar-day { position: absolute; left: 18rpx; right: 18rpx; top: 27rpx; font-size: 50rpx; font-weight: 700; line-height: 1; }
.calendar-month { position: absolute; left: 18rpx; right: 18rpx; top: 82rpx; font-size: 19rpx; font-weight: 600; }
.daily-copy { min-width: 0; margin-left: 22rpx; flex: 1; }
.daily-title { font-size: 28rpx; font-weight: 600; line-height: 1.42; }
.daily-brief { margin-top: 10rpx; color: var(--jj-text-3); font-size: var(--jj-font-caption); line-height: var(--jj-line-caption); }
.discover-section { padding: 10rpx 0 26rpx; overflow: hidden; background: var(--jj-surface); }
.discover-heading { height: 92rpx; padding: 0 28rpx; font-size: 32rpx; font-weight: 700; }
.horizontal-scroll { width: 100%; white-space: nowrap; }
.horizontal-card { width: 650rpx; margin-left: 24rpx; display: inline-flex; position: relative; overflow: hidden; vertical-align: top; flex: 0 0 650rpx; flex-direction: column; box-sizing: border-box; border: 1rpx solid var(--jj-line); border-radius: 7rpx; white-space: normal; background: var(--jj-surface); }
.horizontal-card:last-child { margin-right: 24rpx; }
.selected-pin { height: 348rpx; padding: 24rpx; }
.selected-pin-head, .topic-head, .author-head { display: flex; align-items: center; }
.selected-avatar { width: 64rpx; height: 64rpx; flex: 0 0 auto; border-radius: 50%; }
.selected-identity { min-width: 0; margin-left: 14rpx; flex: 1; }
.selected-name { font-size: 26rpx; font-weight: 600; }
.selected-caption { margin-top: 5rpx; color: var(--jj-text-3); font-size: var(--jj-font-caption); }
.outline-action { min-width: 104rpx; height: 64rpx; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid var(--jj-blue); border-radius: 4rpx; color: var(--jj-blue); background: var(--jj-surface); font-size: var(--jj-font-caption); }
.selected-content { height: 82rpx; margin-top: 18rpx; color: var(--jj-text); font-size: 26rpx; line-height: 1.58; }
.selected-theme-link { color: var(--jj-blue); }
.liked-by { height: 54rpx; display: flex; align-items: center; justify-content: flex-end; color: var(--jj-text-3); font-size: var(--jj-font-caption); }
.liked-avatars { display: flex; margin-right: 8rpx; }
.liked-avatars image { width: 38rpx; height: 38rpx; margin-left: -9rpx; border: 2rpx solid var(--jj-surface); border-radius: 50%; }
.pin-comment-box { height: 64rpx; margin-top: 4rpx; padding: 0 16rpx; display: flex; align-items: center; border-radius: 32rpx; color: var(--jj-text-3); background: var(--jj-fill); font-size: var(--jj-font-caption); }
.pin-comment-box image { width: 42rpx; height: 42rpx; margin-right: 12rpx; border-radius: 50%; opacity: .6; }
.topic-card { width: 674rpx; height: 292rpx; margin-left: 30rpx; padding: 30rpx; flex-basis: 674rpx; }
.topic-card:last-child { margin-right: 30rpx; }
.topic-head { min-width: 0; height: 72rpx; overflow: hidden; flex: 0 0 auto; }
.topic-head .outline-action { flex: 0 0 auto; }
.topic-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; flex: 0 0 auto; border-radius: 5rpx; color: var(--jj-blue); background: var(--jj-blue-soft); font-size: var(--jj-font-caption); font-weight: 700; }
.topic-icon image { width: 100%; height: 100%; display: block; }
.topic-copy { min-width: 0; margin-left: 16rpx; flex: 1; }
.topic-name { font-size: 28rpx; font-weight: 600; }
.topic-stats { margin-top: 7rpx; color: var(--jj-text-3); font-size: var(--jj-font-caption); line-height: 34rpx; white-space: nowrap; }
.topic-preview { height: 134rpx; margin-top: 24rpx; padding: 10rpx 18rpx; overflow: hidden; flex: 0 0 auto; box-sizing: border-box; border-radius: 4rpx; background: var(--jj-fill-2); }
.topic-preview-row { min-width: 0; height: 57rpx; display: flex; align-items: center; overflow: hidden; }
.topic-preview-row image { width: 40rpx; height: 40rpx; margin-right: 12rpx; display: block; flex: 0 0 auto; border-radius: 50%; }
.topic-preview-row text { min-width: 0; height: 36rpx; display: block; overflow: hidden; flex: 1; color: var(--jj-text-2); font-size: var(--jj-font-caption); line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.topic-description { height: 72rpx; margin-top: 23rpx; color: var(--jj-text-2); font-size: var(--jj-font-caption); line-height: 36rpx; }
.recommend-card { height: 600rpx; padding: 28rpx 24rpx 22rpx; background-color: var(--jj-surface); background-repeat: no-repeat; background-size: 100% 180rpx; }
.tint-0 { background-image: linear-gradient(115deg, rgba(222, 255, 245, .9), rgba(255,255,255,0) 72%); }
.tint-1 { background-image: linear-gradient(115deg, rgba(226, 247, 255, .95), rgba(255,255,255,0) 72%); }
.tint-2 { background-image: linear-gradient(115deg, rgba(255, 244, 218, .95), rgba(255,255,255,0) 72%); }
.tint-3 { background-image: linear-gradient(115deg, rgba(238, 230, 255, .9), rgba(255,255,255,0) 72%); }
.recommend-ribbon { position: absolute; top: 0; left: 0; max-width: 130rpx; height: 36rpx; padding: 0 14rpx; display: flex; align-items: center; border-radius: 6rpx 0 6rpx 0; box-sizing: border-box; color: #fff; background: #36c99b; font-size: 19rpx; }
.recommend-head { height: 118rpx; display: flex; align-items: flex-start; justify-content: space-between; overflow: hidden; flex: 0 0 auto; }
.recommend-head > view:first-child { min-width: 0; padding-right: 16rpx; flex: 1; }
.recommend-title { font-size: 31rpx; font-weight: 600; }
.recommend-stats, .recommend-owner { margin-top: 7rpx; color: var(--jj-text-3); font-size: var(--jj-font-caption); }
.recommend-preview { height: 282rpx; margin-top: 20rpx; overflow: hidden; flex: 0 0 auto; }
.preview-row { height: 94rpx; padding: 10rpx 0; overflow: hidden; box-sizing: border-box; }
.preview-row > view { color: var(--jj-text); font-size: 25rpx; line-height: 1.4; }
.preview-row text { display: block; margin-top: 7rpx; color: var(--jj-text-3); font-size: var(--jj-font-caption); }
.recommend-footer { height: 72rpx; margin-top: auto; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; color: var(--jj-text-2); background: var(--jj-fill-2); font-size: var(--jj-font-caption); }
.author-card { height: 540rpx; padding: 28rpx 24rpx 22rpx; }
.author-rank-bg { position: absolute; top: 0; right: 0; width: 260rpx; height: 150rpx; opacity: .55; }
.author-head { position: relative; z-index: 1; }
.author-avatar { width: 78rpx; height: 78rpx; flex: 0 0 auto; border: 4rpx solid rgba(255,255,255,.8); border-radius: 50%; background: var(--jj-fill); }
.author-copy { min-width: 0; margin-left: 14rpx; flex: 1; }
.author-name { font-size: 28rpx; font-weight: 600; }
.author-name text { padding: 2rpx 7rpx; border-radius: 4rpx; color: #fff; background: var(--jj-blue); font-size: 16rpx; font-style: italic; }
.author-stats { margin-top: 7rpx; color: var(--jj-text-2); font-size: var(--jj-font-caption); }
.author-preview { margin-top: 18rpx; }
.article-rank-section { padding-bottom: 14rpx; }
.rank-chips { width: 100%; padding: 0 28rpx 14rpx; box-sizing: border-box; white-space: nowrap; }
.rank-chip { height: 64rpx; margin-right: 12rpx; padding: 0 24rpx; display: inline-flex; align-items: center; border-radius: 32rpx; color: var(--jj-text-2); background: var(--jj-fill); font-size: var(--jj-font-caption); }
.rank-chip.active { color: var(--jj-blue); background: var(--jj-blue-soft); }
.rank-swiper { height: 456rpx; }
.rank-card { height: 426rpx; margin: 0 24rpx; overflow: hidden; border: 1rpx solid var(--jj-line); border-radius: 7rpx; background: var(--jj-surface); }
.rank-card-title { height: 86rpx; padding: 0 28rpx; display: flex; align-items: center; color: var(--jj-blue); background: #eef8ff; font-size: 29rpx; font-weight: 600; }
.rank-card-title text { margin-left: 12rpx; font-size: 34rpx; }
.rank-row { min-height: 108rpx; padding: 0 28rpx; display: flex; align-items: center; box-sizing: border-box; }
.rank-copy { min-width: 0; flex: 1; }
.rank-title { font-size: 25rpx; }
.card-meta { margin-top: 7rpx; color: var(--jj-text-3); font-size: var(--jj-font-caption); }
.industry-section { padding: 0 28rpx 24rpx; box-sizing: border-box; }
.industry-section .discover-heading { padding: 0; }
.headline-row { min-height: 270rpx; padding: 25rpx 0; display: flex; align-items: center; border-bottom: 1rpx solid var(--jj-line); box-sizing: border-box; }
.headline-copy { min-width: 0; flex: 1; }
.headline-title { font-size: 28rpx; font-weight: 600; line-height: 1.42; }
.headline-meta { margin-top: 12rpx; display: flex; align-items: center; color: var(--jj-text-3); font-size: var(--jj-font-caption); }
.headline-meta image { width: 32rpx; height: 32rpx; margin-right: 8rpx; border-radius: 50%; }
.meta-divider { width: 1rpx; height: 23rpx; margin: 0 12rpx; background: var(--jj-line); }
.headline-brief { margin-top: 11rpx; color: var(--jj-text-2); font-size: var(--jj-font-caption); line-height: var(--jj-line-caption); }
.headline-actions { margin-top: 15rpx; display: flex; gap: 42rpx; color: var(--jj-text-3); font-size: var(--jj-font-caption); }
.headline-actions > view { display: flex; align-items: center; gap: 7rpx; }
.headline-actions image { width: 28rpx; height: 28rpx; }
.headline-image { width: 164rpx; height: 128rpx; margin-left: 22rpx; flex: 0 0 auto; border-radius: 3rpx; background: var(--jj-fill); }
.loading-line, .list-end, .cache-note { padding: 24rpx; color: var(--jj-text-3); font-size: var(--jj-font-caption); text-align: center; }
.find-page.dark .find-sticky,
.find-page.dark .find-top { background: #111820; }
.find-page.dark .search-bar {
  border: 1rpx solid rgba(255, 255, 255, .04);
  background: var(--jj-fill);
  box-shadow: none;
}
.find-page.dark .channel-item {
  border-color: #2c333b;
  background: #1a2026;
  box-shadow: none;
}
.find-page.dark .daily-card {
  border-color: #343b44;
  background: linear-gradient(180deg, rgba(30, 128, 255, .08), rgba(30, 128, 255, .015) 48%, rgba(30, 128, 255, 0)), var(--jj-surface);
}
.find-page.dark .horizontal-card { border-color: #36373b; }
.find-page.dark .outline-action { background: transparent; }
.find-page.dark .recommend-card { background-color: var(--jj-surface); }
.find-page.dark .tint-0 { background-image: linear-gradient(115deg, rgba(30, 128, 255, .18), rgba(30, 128, 255, 0) 72%); }
.find-page.dark .tint-1 { background-image: linear-gradient(115deg, rgba(54, 201, 155, .16), rgba(54, 201, 155, 0) 72%); }
.find-page.dark .tint-2 { background-image: linear-gradient(115deg, rgba(255, 159, 26, .14), rgba(255, 159, 26, 0) 72%); }
.find-page.dark .tint-3 { background-image: linear-gradient(115deg, rgba(132, 102, 255, .16), rgba(132, 102, 255, 0) 72%); }
.find-page.dark .recommend-footer,
.find-page.dark .topic-preview,
.find-page.dark .pin-comment-box { background: var(--jj-fill); }
.find-page.dark .rank-card-title { background: var(--jj-fill-2); }
