.find-page {
  padding-bottom: 24rpx;
}

.find-hero {
  height: 260rpx;
  padding: 34rpx 32rpx;
  box-sizing: border-box;
  background: var(--jj-surface) url('/assets/app/find/find_page_bg_top.webp') center bottom / 100% auto no-repeat;
}

.find-title {
  color: var(--jj-text);
  font-size: 42rpx;
  font-weight: 700;
}

.search-bar {
  height: 72rpx;
  margin-top: 30rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid var(--jj-line);
  color: var(--jj-text-3);
}

.search-bar image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.daily-card {
  min-height: 150rpx;
  margin: -42rpx 24rpx 0;
  padding: 26rpx 24rpx 24rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 8rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  box-shadow: 0 8rpx 32rpx rgba(31, 35, 41, 0.08);
}

.daily-copy {
  min-width: 0;
  flex: 1;
}

.daily-copy image {
  width: 178rpx;
  height: 48rpx;
}

.daily-copy text {
  display: block;
  margin-top: 10rpx;
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.calendar {
  width: 110rpx;
  height: 100rpx;
}

.quick-grid {
  padding: 18rpx 18rpx 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4rpx;
}

.quick-item {
  min-height: 124rpx;
  padding: 18rpx 16rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.quick-item image {
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
}

.quick-text {
  min-width: 0;
}

.quick-name {
  color: var(--jj-text);
  font-size: 28rpx;
  font-weight: 600;
}

.quick-caption {
  margin-top: 7rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.daily-section {
  margin-top: 16rpx;
}
