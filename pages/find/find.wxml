<view class="page find-page">
  <view class="find-top">
    <status-bar></status-bar>
    <view class="search-bar" bindtap="openSearch">
      <image src="{{darkMode ? '/assets/app/find/dark/find_page_ic_search.svg' : '/assets/app/find/find_page_ic_search.svg'}}" mode="aspectFit"></image>
      <text>探索稀土掘金</text>
    </view>

    <view class="channel-grid">
      <view wx:for="{{channelEntries}}" wx:key="title" class="channel-item" data-url="{{item.url}}" bindtap="openFeature">
        <image src="{{darkMode ? item.darkIcon : item.icon}}" mode="aspectFit"></image>
        <text>{{item.title}}</text>
      </view>
    </view>

    <swiper class="quick-swiper" indicator-dots circular="{{false}}" duration="240">
      <swiper-item>
        <view class="quick-grid">
          <view wx:for="{{quickEntries}}" wx:key="name" class="quick-item" data-url="{{item.url}}" bindtap="openFeature">
            <image src="{{item.icon}}" mode="aspectFit"></image>
            <text>{{item.name}}</text>
          </view>
        </view>
      </swiper-item>
      <swiper-item><view class="quick-grid"></view></swiper-item>
    </swiper>
  </view>

  <swiper wx:if="{{themes.length}}" class="find-banner" indicator-dots circular autoplay interval="5000">
    <swiper-item wx:for="{{themes}}" wx:key="theme_id" data-index="{{index}}" bindtap="openTheme">
      <image src="{{item.cover}}" mode="aspectFill"></image>
      <view class="banner-shade"></view>
      <view class="banner-copy"><view class="ellipsis">{{item.name}}</view><text class="two-lines">{{item.brief}}</text></view>
    </swiper-item>
  </swiper>
  <view wx:else class="find-banner default-banner" bindtap="openTheme"><image src="/assets/app/find/find_page_ic_default_banner.webp" mode="aspectFill"></image></view>

  <view class="daily-card" bindtap="openDaily">
    <view class="daily-heading">
      <image src="{{darkMode ? '/assets/app/find/dark/find_page_ic_title_juejin_daily.svg' : '/assets/app/find/find_page_ic_title_juejin_daily.svg'}}" mode="aspectFit"></image>
      <view catchtap="openDailyHistory">往日精彩 <text>›</text></view>
    </view>
    <view wx:if="{{dailyArticle}}" class="daily-content">
      <image class="calendar" src="{{darkMode ? '/assets/app/find/dark/find_page_bg_calendar.webp' : '/assets/app/find/find_page_bg_calendar.webp'}}" mode="aspectFit"></image>
      <view class="daily-copy"><view class="daily-title two-lines">{{dailyArticle.title}}</view><view class="daily-brief two-lines">{{dailyArticle.brief_content || greeting}}</view></view>
    </view>
    <empty-state wx:if="{{!loading && !dailyArticle}}" text="今日内容还在准备中"></empty-state>
  </view>

  <view class="discover-section">
    <view class="discover-heading"><text>精选沸点</text><view bindtap="openSelectedPins">查看更多 ›</view></view>
    <scroll-view class="horizontal-scroll" scroll-x enable-flex>
      <view wx:for="{{selectedPins}}" wx:key="msg_id" class="selected-pin horizontal-card" data-id="{{item.msg_id}}" bindtap="openPin">
        <view class="selected-pin-head">
          <image class="selected-avatar" src="{{item.author.avatar_large}}" mode="aspectFill" data-id="{{item.author.user_id}}" catchtap="openAuthor"></image>
          <view class="selected-identity"><view class="selected-name ellipsis">{{item.author.user_name}}</view><view class="selected-caption ellipsis">{{item.author.job_title || item.ctime}}</view></view>
          <view class="outline-action" catchtap="openAccountInfo">关注</view>
        </view>
        <view class="selected-content four-lines">{{item.content}}</view>
        <view class="selected-actions"><text>赞 {{item.digg_count}}</text><text>评论 {{item.comment_count}}</text></view>
      </view>
    </scroll-view>
    <empty-state wx:if="{{!loading && !selectedPins.length}}" text="暂时没有精选沸点"></empty-state>
  </view>

  <view class="discover-section">
    <view class="discover-heading"><text>推荐圈子</text><view bindtap="openCircleSquare">圈子广场 ›</view></view>
    <scroll-view class="horizontal-scroll" scroll-x enable-flex>
      <view wx:for="{{topics}}" wx:key="topic_id" class="topic-card horizontal-card" data-id="{{item.topic_id}}" bindtap="openTopic">
        <view class="topic-icon"><image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFill"></image><text wx:else>{{item.iconText}}</text></view>
        <view class="topic-name ellipsis">{{item.title}}</view>
        <view class="topic-stats">{{item.follower_count}} 掘友 · {{item.msg_count}} 沸点</view>
        <view class="fill-action" catchtap="openAccountInfo">加入</view>
      </view>
    </scroll-view>
    <empty-state wx:if="{{!loading && !topics.length}}" text="暂时没有推荐圈子"></empty-state>
  </view>

  <view class="discover-section">
    <view class="discover-heading"><text>推荐专栏</text><view bindtap="openColumnList">查看更多 ›</view></view>
    <scroll-view wx:if="{{columns.length}}" class="horizontal-scroll" scroll-x enable-flex>
      <view wx:for="{{columns}}" wx:key="column_id" class="column-card horizontal-card" data-index="{{index}}" bindtap="openColumn">
        <view class="recommend-card-head"><view class="column-cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"></image><text wx:else>{{item.tag || '专栏'}}</text></view><view class="outline-action" catchtap="openAccountInfo">订阅</view></view>
        <view class="card-title two-lines">{{item.title}}</view><view class="card-meta">{{item.follower_count}} 订阅 · {{item.article_count}} 篇文章</view><view class="card-meta">{{item.creator.user_name}} 的专栏</view>
        <view class="recommend-preview"><view wx:for="{{item.articles}}" wx:for-item="article" wx:key="article_id" class="preview-row" data-id="{{article.article_id}}" catchtap="openArticle"><view class="ellipsis">{{article.title}}</view><text>点赞 {{article.digg_count}} · 评论 {{article.comment_count}}</text></view></view>
        <view class="recommend-footer">查看专栏 · {{item.article_count}}篇文章</view>
      </view>
    </scroll-view>
    <empty-state wx:if="{{!loading && !columns.length}}" text="当前暂无公开推荐专栏"></empty-state>
  </view>

  <view class="discover-section">
    <view class="discover-heading"><text>推荐收藏集</text><view bindtap="openCollectionList">查看更多 ›</view></view>
    <scroll-view class="horizontal-scroll" scroll-x enable-flex>
      <view wx:for="{{collectionSets}}" wx:key="collection_id" class="collection-card horizontal-card" data-index="{{index}}" bindtap="openCollection">
        <view class="collection-top"><view class="collection-mark">藏</view><view class="outline-action" catchtap="openAccountInfo">订阅</view></view>
        <view class="card-title two-lines">{{item.name}}</view>
        <view class="card-meta">{{item.creator.user_name}} · {{item.article_count}} 篇文章</view>
        <view class="recommend-preview"><view wx:for="{{item.articles}}" wx:for-item="article" wx:key="article_id" class="preview-row" data-id="{{article.article_id}}" catchtap="openArticle"><view class="ellipsis">{{article.title}}</view><text>{{article.author.user_name}} · 点赞 {{article.digg_count}} · 评论 {{article.comment_count}}</text></view></view>
        <view class="recommend-footer">查看收藏集 · {{item.article_count}}篇文章</view>
      </view>
    </scroll-view>
    <empty-state wx:if="{{!loading && !collectionSets.length}}" text="暂时没有推荐收藏集"></empty-state>
  </view>

  <view class="discover-section">
    <view class="discover-heading"><text>作者榜</text><view data-type="author" bindtap="openRank">完整榜单 ›</view></view>
    <scroll-view class="horizontal-scroll" scroll-x enable-flex>
      <view wx:for="{{authors}}" wx:key="user_id" class="author-card horizontal-card" data-id="{{item.user_id}}" bindtap="openAuthor">
        <image class="author-avatar" src="{{item.avatar_large}}" mode="aspectFill"></image>
        <view class="card-title ellipsis">{{item.user_name}}</view><view class="card-meta ellipsis">{{item.job_title || item.company || '优秀创作者'}}</view>
        <view class="author-stats">获赞 {{item.got_digg_count}} · 阅读 {{item.got_view_count}}</view>
        <view class="fill-action" catchtap="openAccountInfo">关注</view>
      </view>
    </scroll-view>
    <empty-state wx:if="{{!loading && !authors.length}}" text="暂时没有推荐作者"></empty-state>
  </view>

  <view class="discover-section article-rank-section">
    <view class="discover-heading"><text>文章榜</text><view data-type="article" bindtap="openRank">完整榜单 ›</view></view>
    <scroll-view class="rank-chips" scroll-x enable-flex><view wx:for="{{rankCategories}}" wx:key="id" class="rank-chip {{activeRankCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectRankCategory">{{item.name}}</view></scroll-view>
    <view wx:for="{{hotArticles}}" wx:key="article_id" class="rank-row" data-id="{{item.article_id}}" bindtap="openArticle"><view class="rank-index rank-{{index + 1}}">{{index + 1}}</view><view class="rank-copy"><view class="rank-title two-lines">{{item.title}}</view><view class="card-meta">{{item.author.user_name}} · 热度 {{item.hot_rank}}</view></view></view>
    <view wx:if="{{rankLoading}}" class="loading-line">正在切换榜单...</view>
  </view>

  <view class="discover-section industry-section">
    <view class="discover-heading"><text>行业速递</text><view data-url="/pages/discoverChannel/discoverChannel?type=news&title=行业速递" bindtap="openFeature">查看更多 ›</view></view>
    <view wx:for="{{headlines}}" wx:key="content_id" class="headline-row" data-index="{{index}}" bindtap="openHeadline"><view class="headline-copy"><view class="rank-title two-lines">{{item.title}}</view><view class="card-meta">{{item.source}} · {{item.publish_time}}</view><view class="headline-brief two-lines">{{item.brief}}</view></view><image wx:if="{{item.thumbnail}}" src="{{item.thumbnail}}" mode="aspectFill"></image></view>
    <empty-state wx:if="{{!loading && !headlines.length}}" text="暂时没有行业资讯"></empty-state>
  </view>

  <view wx:if="{{loading}}" class="loading-line">正在加载发现内容...</view>
  <view wx:if="{{loadError && !loading}}" class="cache-note">部分内容暂时不可用</view>
</view>
