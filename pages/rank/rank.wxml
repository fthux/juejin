<view class="page rank-page">
  <view class="rank-fixed-nav {{navVisible ? 'visible' : ''}}" style="opacity: {{navOpacity}};"><status-bar navigation="{{true}}"><view class="rank-nav"><view class="nav-back" bindtap="goBack">‹</view><text>{{title}}</text><view class="rank-rules" bindtap="showRules">{{type === 'article' ? '排名规则' : ''}}</view></view></status-bar></view>
  <status-bar navigation="{{true}}"><view class="rank-nav"><view class="nav-back" bindtap="goBack">‹</view><text>{{title}}</text><view class="rank-rules" bindtap="showRules">{{type === 'article' ? '排名规则' : ''}}</view></view></status-bar>

  <block wx:if="{{type === 'article'}}">
    <scroll-view class="category-tabs" scroll-x enable-flex scroll-into-view="category-{{activeCategoryIndex}}"><view wx:for="{{categories}}" wx:key="id" id="category-{{index}}" class="category-tab {{activeCategoryIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectCategory">{{item.name}}</view></scroll-view>
    <view class="period-tabs"><view wx:for="{{timeRanges}}" wx:key="id" class="period-tab {{activePeriod === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectPeriod">{{item.name}}</view></view>
    <view class="rank-article-list"><view wx:for="{{articles}}" wx:key="article_id" class="rank-article" data-index="{{index}}" bindtap="openArticle"><view class="rank-article-title two-lines">{{item.title}}</view><view class="rank-author-row"><image src="{{item.author.avatar_large}}" mode="aspectFill" referrer-policy="no-referrer"></image><text>{{item.author.user_name}}</text><text class="divider"></text><text>{{item.ctime}}</text></view><view wx:if="{{item.brief_content}}" class="rank-brief two-lines">{{item.brief_content}}</view><view class="rank-actions"><view><image src="/assets/app/find/find_page_ic_undigg.svg" mode="aspectFit"></image><text>{{item.digg_label}}</text></view><view><image src="/assets/app/find/find_page_ic_comment.svg" mode="aspectFit"></image><text>{{item.comment_label}}</text></view><text wx:if="{{item.tags.length}}" class="rank-tag">{{item.tags[0]}}</text></view></view></view>
  </block>

  <block wx:elif="{{type === 'collect'}}">
    <view class="rank-hero"><image class="rank-hero-bg" src="/assets/app/rank/bg_rank_list_head.webp" mode="aspectFill"></image><view class="rank-hero-copy"><view class="rank-title">收藏榜</view><view class="rank-caption">本周最值得收藏的优质技术文章</view></view></view>
    <view class="surface rank-content"><view class="list-title"><text>收藏排行</text><text>实时更新</text></view><view wx:for="{{articles}}" wx:key="article_id" class="collection-row" data-index="{{index}}" bindtap="openArticle"><view class="rank-number"><image wx:if="{{item.medal}}" src="{{item.medal}}" mode="aspectFit"></image><text wx:else>{{index + 1}}</text></view><view class="collection-copy"><view class="collection-title two-lines">{{item.title}}</view><view class="collection-meta"><text>{{item.author.user_name}}</text><text>{{item.collect_count}} 收藏</text></view></view></view></view>
  </block>

  <block wx:else>
    <view class="rank-hero"><image class="rank-hero-bg" src="/assets/app/rank/bg_rank_list_head.webp" mode="aspectFill"></image><view class="rank-hero-copy"><view class="rank-title">作者榜</view><view class="rank-caption">发现本周最受关注的优秀创作者</view></view></view>
    <view class="surface rank-content author-content"><view class="author-podium"><view wx:for="{{authors}}" wx:key="user_id" wx:if="{{index < 3}}" class="podium-item podium-{{index + 1}}" data-index="{{index}}" bindtap="openAuthor"><view class="podium-avatar"><image src="{{item.avatar_large}}" mode="aspectFill"></image><image class="podium-medal" src="{{item.medal}}" mode="aspectFit"></image></view><view class="podium-name ellipsis">{{item.user_name}}</view><view class="podium-count">{{item.follower_count}} 关注者</view></view></view><view class="list-title author-list-title"><text>作者排行</text><text>每周更新</text></view><view wx:for="{{authors}}" wx:key="user_id" wx:if="{{index > 2}}" class="author-row" data-index="{{index}}" bindtap="openAuthor"><view class="author-rank">{{index + 1}}</view><image class="avatar" src="{{item.avatar_large}}" mode="aspectFill"></image><view class="author-copy"><view class="author-name">{{item.user_name}}</view><view class="author-caption ellipsis">{{item.job_title}}<text wx:if="{{item.company}}"> @ {{item.company}}</text></view><view class="author-stats">{{item.follower_count}} 关注者 · 获赞 {{item.got_digg_count}}</view></view><view class="follow-button" catchtap="openAccountInfo">关注</view></view></view>
  </block>
  <view wx:if="{{loading}}" class="loading-line">正在加载榜单...</view>
  <view wx:if="{{loadingMore}}" class="loading-line">正在加载更多文章...</view>
  <view wx:if="{{type === 'article' && !loading && !loadingMore && !articleHasMore && articles.length}}" class="list-end">已加载全部文章</view>
</view>
