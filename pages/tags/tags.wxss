.tags-page { background: var(--jj-surface); }.tags-tabs { height: 100rpx; display: grid; grid-template-columns: repeat(2, 1fr); border-bottom: 1rpx solid var(--jj-line); }.tags-tabs view { display: flex; align-items: center; justify-content: center; color: var(--jj-text-3); }.tags-tabs .active { color: var(--jj-blue); border-bottom: 5rpx solid var(--jj-blue); }.tag-row { min-height: 150rpx; padding: 22rpx 36rpx; display: flex; align-items: center; box-sizing: border-box; border-bottom: 1rpx solid var(--jj-line); }.tag-logo { width: 82rpx; height: 82rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: var(--jj-blue); font-weight: 700; }.tag-name { margin-left: 22rpx; flex: 1; color: var(--jj-text); font-size: 30rpx; }.tag-name text { display: block; margin-top: 8rpx; color: var(--jj-text-3); font-size: 22rpx; }.tag-follow { min-width: 116rpx; height: 60rpx; border-radius: 30rpx; display: flex; align-items: center; justify-content: center; color: var(--jj-blue); background: var(--jj-fill); }
