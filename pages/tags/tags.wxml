<view class="page tags-page"><view class="tags-tabs"><view class="{{activeTab === 'all' ? 'active' : ''}}" data-id="all" bindtap="switchTab">全部标签</view><view class="{{activeTab === 'followed' ? 'active' : ''}}" data-id="followed" bindtap="switchTab">关注标签</view></view><view wx:for="{{tags}}" wx:key="id" class="tag-row"><view class="tag-logo">{{item.initial}}</view><view class="tag-name">{{item.name}}<text>技术内容与社区讨论</text></view><view class="tag-follow" data-id="{{item.id}}" bindtap="toggle">{{item.followed ? '已关注' : '+ 关注'}}</view></view></view>
