<view class="page tags-page">
  <view class="tags-tabs">
    <view class="{{activeTab === 'all' ? 'active' : ''}}" data-id="all" bindtap="switchTab">全部标签</view>
    <view class="{{activeTab === 'followed' ? 'active' : ''}}" data-id="followed" bindtap="switchTab">关注标签</view>
  </view>
  <view wx:for="{{tags}}" wx:key="id" class="tag-row">
    <view class="tag-logo {{item.tone}}"><text>{{item.logo}}</text></view>
    <view class="tag-copy">
      <view class="tag-name">{{item.name}}</view>
      <view class="tag-meta">{{item.followers}} 人关注 · {{item.articles}} 篇文章</view>
    </view>
    <view class="tag-follow {{item.followed ? 'followed' : ''}}" data-id="{{item.id}}" bindtap="toggle">{{item.followed ? '已关注' : '+ 关注'}}</view>
  </view>
  <empty-state wx:if="{{!tags.length}}" text="还没有关注标签"></empty-state>
</view>
