<view class="page mine-page">
  <view class="mine-header surface">
    <view class="mine-title">我</view>
    <view class="mine-head-actions">
      <view class="head-icon" bindtap="openNotifications">◔<text wx:if="{{unread}}" class="head-badge">{{unread}}</text></view>
      <navigator class="head-icon" url="/pages/setting/setting">⚙</navigator>
    </view>
  </view>

  <view class="user-panel surface" bindtap="openProfile">
    <image class="user-avatar" src="{{user ? user.avatar_large : '/assets/app/common/default_avatar.webp'}}" mode="aspectFill"></image>
    <view class="user-copy">
      <view class="user-name">{{user ? user.user_name : '登录体验完整功能'}}</view>
      <view class="user-caption ellipsis">{{user ? ((user.job_title || '') + (user.company ? ' @ ' + user.company : '')) : '收藏、历史和创作内容保存在本机'}}</view>
    </view>
    <view class="user-arrow">›</view>
  </view>

  <view wx:if="{{user}}" class="user-stats surface">
    <view><text>{{user.followee_count || 0}}</text><text>关注</text></view>
    <view><text>{{user.follower_count || 0}}</text><text>关注者</text></view>
    <view><text>{{user.power || 0}}</text><text>矿石</text></view>
    <view><text>Lv.{{user.level || 1}}</text><text>等级</text></view>
  </view>

  <view class="feature-grid section">
    <view wx:for="{{featureEntries}}" wx:key="name" class="feature-item" data-url="{{item.url}}" bindtap="openEntry">
      <image src="{{item.icon}}" mode="aspectFit"></image>
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="creator-banner" bindtap="openPublish">
    <view>
      <view class="creator-title">开始创作</view>
      <view class="creator-copy">分享技术与思考，记录你的成长</view>
    </view>
    <view class="creator-arrow">写文章 ›</view>
  </view>

  <view class="menu-list section">
    <view wx:for="{{menuEntries}}" wx:key="name" class="menu-row" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="openEntry">
      <view class="menu-mark">{{item.mark}}</view>
      <view class="menu-name">{{item.name}}</view>
      <view wx:if="{{item.countKey}}" class="menu-count">{{counts[item.countKey]}}</view>
      <view wx:elif="{{item.name === '消息中心' && unread}}" class="menu-badge">{{unread}}</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>
