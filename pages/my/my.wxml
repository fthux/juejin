<view class="page mine-page">
  <status-bar navigation="{{true}}">
    <view class="mine-header surface">
      <image class="head-icon" src="/assets/app/user/ic_user_scan.svg" mode="aspectFit" bindtap="openScan"></image>
      <view class="mine-head-actions">
        <image class="head-icon" src="/assets/app/user/ic_user_theme.svg" mode="aspectFit" bindtap="openTheme"></image>
        <view class="head-icon notice-button" bindtap="openNotifications">
          <view class="bell-icon"></view>
          <text wx:if="{{unread}}" class="head-badge">{{unread}}</text>
        </view>
        <image class="head-icon" src="/assets/app/user/ic_user_settings.svg" mode="aspectFit" bindtap="openSettings"></image>
      </view>
    </view>
  </status-bar>

  <view class="user-zone surface">
    <view class="user-panel" bindtap="openProfile">
      <image class="user-avatar" src="{{user ? user.avatar_large : '/assets/app/common/default_avatar.webp'}}" mode="aspectFill"></image>
      <view class="user-copy">
        <view class="user-name">{{user ? user.user_name : '登录体验完整功能'}}</view>
        <view class="user-badges">
          <image src="/assets/app/user/ic_user_lv1.webp" mode="aspectFit"></image>
          <text>{{user ? '个人主页' : '收藏与创作数据保存在本机'}} ›</text>
        </view>
      </view>
    </view>

    <view class="user-stats">
      <view><text>{{counts.likes}}</text><text>点赞</text></view>
      <view bindtap="openCollections"><text>{{counts.collections}}</text><text>收藏</text></view>
      <view><text>{{counts.follows}}</text><text>关注</text></view>
    </view>
  </view>

  <view class="member-banner">
    <view class="member-copy">年度会员限时五折 领小册周边福利</view>
    <view class="member-action">了解一下</view>
  </view>

  <view class="feature-grid mine-section">
    <view wx:for="{{featureEntries}}" wx:key="name" class="feature-item" data-url="{{item.url}}" data-message="{{item.message}}" bindtap="openEntry">
      <image src="{{item.icon}}" mode="aspectFit"></image>
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="creator-section mine-section">
    <view class="mine-section-head" bindtap="openCreator">
      <view>创作者中心</view>
      <text>进入首页 ›</text>
    </view>
    <view class="creator-grid">
      <view wx:for="{{creatorEntries}}" wx:key="name" class="creator-item" data-url="{{item.url}}" bindtap="openEntry">
        <image src="{{item.icon}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
    </view>
    <view class="activity-ticker" bindtap="openActivity">
      <text>活动</text>
      <view class="ellipsis">「TRAE Work 实战帮」征文启动！你的经验值得被看见</view>
      <text>›</text>
    </view>
  </view>

  <view class="more-section mine-section">
    <view class="mine-section-head"><view>更多功能</view></view>
    <view class="more-grid">
      <view wx:for="{{moreEntries}}" wx:key="name" class="more-item" data-url="{{item.url}}" data-tab="{{item.tab}}" data-message="{{item.message}}" bindtap="openEntry">
        <image src="{{item.icon}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>
</view>
