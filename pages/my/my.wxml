<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page mine-page {{themeName}}">
  <status-bar navigation="{{true}}">
    <view class="mine-header surface">
      <image class="head-icon" src="/assets/app/user/ic_user_scan.png" mode="aspectFit" bindtap="openScan"></image>
      <view class="mine-head-actions">
        <image class="head-icon" src="{{themeName === 'dark' ? '/assets/app/user/ic_user_theme.png' : '/assets/app/user/ic_theme_normal.png'}}" mode="aspectFit" bindtap="openTheme"></image>
        <view class="head-icon notice-button" bindtap="openNotifications">
          <image class="notice-icon" src="/assets/app/user/ic_user_notice.png" mode="aspectFit"></image>
          <text wx:if="{{unread}}" class="head-badge">{{unread}}</text>
        </view>
        <image class="head-icon" src="/assets/app/user/ic_user_settings.png" mode="aspectFit" bindtap="openSettings"></image>
      </view>
    </view>
  </status-bar>

  <view class="user-zone surface">
    <view class="user-panel" bindtap="openProfile">
      <image class="user-avatar" src="{{user ? user.avatar_large : '/assets/app/common/default_avatar.webp'}}" mode="aspectFill"></image>
      <view class="user-copy">
        <view class="user-name">{{user ? user.user_name : '登录/注册'}}</view>
        <view wx:if="{{user}}" class="user-badges">
          <image src="/assets/app/user/ic_user_lv1.webp" mode="aspectFit"></image>
          <text>个人主页 ›</text>
        </view>
      </view>
    </view>

    <view class="user-stats">
      <view><text>{{counts.likes}}</text><text>点赞</text></view>
      <view bindtap="openCollections"><text>{{counts.collections}}</text><text>收藏</text></view>
      <view><text>{{counts.follows}}</text><text>关注</text></view>
    </view>
  </view>

  <view class="member-banner" bindtap="openVip">
    <view class="member-copy">年度会员限时五折 领小册周边福利</view>
    <view class="member-action">了解一下</view>
  </view>

  <view class="feature-grid mine-section">
    <view wx:for="{{featureEntries}}" wx:key="name" class="feature-item" data-url="{{item.url}}" data-auth="{{item.auth}}" data-message="{{item.message}}" bindtap="openEntry">
      <image src="{{item.icon}}" mode="aspectFit"></image>
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="creator-section mine-section">
    <view class="mine-section-head" bindtap="openCreator">
      <view>创作者中心</view>
      <text>进入首页 ›</text>
    </view>
    <view class="creator-grid">
      <view wx:for="{{creatorEntries}}" wx:key="name" class="creator-item" data-url="{{item.url}}" data-auth="{{item.auth}}" bindtap="openEntry">
        <image src="{{item.icon}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
    </view>
    <view wx:if="{{activityNotices.length}}" class="activity-ticker" bindtap="openActivityNotice">
      <swiper class="activity-swiper" vertical="{{true}}" autoplay="{{activityNotices.length > 1}}" interval="3500" duration="350" circular="{{activityNotices.length > 1}}" disable-touch="{{true}}">
        <swiper-item wx:for="{{activityNotices}}" wx:key="id" class="activity-slide">
          <text class="activity-type">{{item.type}}</text>
          <view class="activity-title ellipsis">{{item.title}}</view>
          <text class="activity-arrow">›</text>
        </swiper-item>
      </swiper>
    </view>
  </view>

  <view class="more-section mine-section">
    <view class="mine-section-head"><view>更多功能</view></view>
    <view class="more-grid">
      <view wx:for="{{moreEntries}}" wx:key="name" class="more-item" data-url="{{item.url}}" data-tab="{{item.tab}}" data-auth="{{item.auth}}" data-message="{{item.message}}" bindtap="openEntry">
        <image src="{{item.icon}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>
</view>
