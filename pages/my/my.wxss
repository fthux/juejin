.mine-page {
  padding-bottom: calc(var(--jj-tabbar-height) + 28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--jj-tabbar-height) + 28rpx + env(safe-area-inset-bottom));
  background: var(--jj-bg);
}

.mine-header {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
}

.mine-head-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.head-action {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.head-action-icon {
  width: 44rpx;
  height: 44rpx;
}

.mine-page.dark .head-action-icon {
  filter: brightness(0) invert(1);
  opacity: 0.78;
}

.head-badge {
  position: absolute;
  top: 0;
  right: -3rpx;
  min-width: 27rpx;
  height: 27rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #f53f3f;
  font-size: 17rpx;
  line-height: 27rpx;
  text-align: center;
}

.user-zone {
  padding: 26rpx 0 22rpx;
}

.user-panel {
  min-height: 142rpx;
  padding: 10rpx 34rpx 20rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--jj-fill);
}

.user-copy {
  min-width: 0;
  margin-left: 24rpx;
  flex: 1;
}

.user-name {
  color: var(--jj-text);
  font-size: 36rpx;
  font-weight: 700;
}

.user-badges {
  margin-top: 15rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.user-badges image {
  width: 54rpx;
  height: 30rpx;
}

.user-stats {
  padding: 10rpx 48rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.user-stats view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.user-stats text:first-child {
  color: var(--jj-text);
  font-size: 32rpx;
}

.member-banner {
  min-height: 88rpx;
  margin: 18rpx 28rpx;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: #f4d7a0;
  background: #34385f;
}

.member-copy {
  min-width: 0;
  flex: 1;
  font-size: 25rpx;
}

.member-action {
  margin-left: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  color: #5d4b29;
  background: #f7dfa8;
  font-size: 22rpx;
}

.mine-section {
  margin: 18rpx 28rpx 0;
  border-radius: 8rpx;
  background: var(--jj-surface);
}

.feature-grid,
.creator-grid,
.more-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.feature-grid {
  padding: 28rpx 12rpx;
}

.feature-item,
.creator-item,
.more-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--jj-text-2);
  font-size: 23rpx;
  text-align: center;
}

.feature-item {
  gap: 12rpx;
}

.feature-item image {
  width: 72rpx;
  height: 72rpx;
}

.mine-section-head {
  height: 86rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--jj-text);
  font-size: 30rpx;
  font-weight: 600;
}

.mine-section-head text {
  color: var(--jj-text-3);
  font-size: 23rpx;
  font-weight: 400;
}

.creator-grid {
  padding: 10rpx 10rpx 24rpx;
}

.creator-section.has-activity {
  padding-bottom: 22rpx;
}

.creator-item {
  gap: 12rpx;
}

.creator-item image {
  width: 64rpx;
  height: 64rpx;
}

.activity-ticker {
  height: 64rpx;
  margin: 0 22rpx;
  padding: 0;
  border-radius: 6rpx;
  box-sizing: border-box;
  color: var(--jj-text-2);
  background: var(--jj-fill);
  font-size: 22rpx;
}

.activity-swiper {
  width: 100%;
  height: 64rpx;
}

.activity-slide {
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.activity-type {
  color: #ff7d00;
}

.activity-title {
  min-width: 0;
  flex: 1;
}

.activity-arrow {
  color: var(--jj-text-3);
  font-size: 32rpx;
}

.more-grid {
  padding: 6rpx 10rpx 30rpx;
  row-gap: 34rpx;
}

.more-item {
  gap: 10rpx;
}

.more-item image {
  width: 58rpx;
  height: 58rpx;
}

.open-source-entry {
  min-height: 76rpx;
  margin: 12rpx 28rpx 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.open-source-separator {
  margin: 0 10rpx;
}

.open-source-link {
  color: var(--jj-text-2);
}
