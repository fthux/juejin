.sign-page {
  padding-bottom: 24rpx;
}

.sign-hero {
  position: relative;
  height: 330rpx;
  overflow: hidden;
  background: #1e80ff;
}

.sign-hero > image {
  width: 100%;
  height: 100%;
}

.sign-overlay {
  position: absolute;
  inset: 0;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.sign-days {
  font-size: 36rpx;
  font-weight: 700;
}

.sign-mineral {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.sign-button {
  width: 220rpx;
  height: 70rpx;
  margin-top: 42rpx;
  border-radius: 35rpx;
  color: #8a5a16;
  background: #fff3d6;
  font-size: 27rpx;
  line-height: 70rpx;
  text-align: center;
}

.sign-button.signed {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.25);
}

.week-card {
  margin: -28rpx 24rpx 0;
  padding: 28rpx 12rpx;
  position: relative;
  z-index: 2;
  border-radius: 8rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.08);
}

.day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: #8a919f;
  font-size: 20rpx;
}

.day.today {
  color: #1e80ff;
  font-weight: 600;
}

.day-reward {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f3ff;
}

.day-reward.signed {
  background: #fff3d6;
}

.day-reward image {
  width: 34rpx;
  height: 34rpx;
}

.task-section {
  margin-top: 24rpx;
}

.task-row {
  min-height: 112rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-top: 1rpx solid #e5e6eb;
}

.task-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1e80ff;
  background: #e8f3ff;
  font-weight: 600;
}

.task-copy {
  margin-left: 18rpx;
  flex: 1;
}

.task-name {
  font-size: 27rpx;
}

.task-reward {
  margin-top: 7rpx;
  color: #ff7d00;
  font-size: 22rpx;
}

.task-row .primary-button,
.task-row .secondary-button {
  min-height: 58rpx;
  padding: 0 22rpx;
  font-size: 23rpx;
}
