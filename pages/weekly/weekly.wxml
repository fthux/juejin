<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackgroundColor}}" background-text-style="{{themeBackgroundTextStyle}}"></page-meta>
<view class="page weekly-page">
  <view wx:if="{{weekly}}" class="weekly-detail">
    <view class="weekly-hero"><image class="weekly-cover" src="{{weekly.cover || '/assets/app/find/find_page_ic_default_banner.png'}}" mode="aspectFill" referrer-policy="no-referrer"></image></view>
    <view class="weekly-info surface"><view class="weekly-title">{{weekly.name}}</view><view class="weekly-owner"><image src="{{weekly.creator.avatar_large || '/assets/app/common/ic_juejin_logo.png'}}" mode="aspectFill"></image><view class="weekly-owner-copy"><view>{{weekly.creator.user_name}} <text wx:if="{{weekly.creator.level}}" class="weekly-level">LV.{{weekly.creator.level}}</text></view><view class="weekly-created">创建于{{weekly.create_time || '2022-01-12'}}</view></view><view class="weekly-subscribe {{weeklyFollowed ? 'followed' : ''}}" bindtap="subscribeWeekly">{{weeklyFollowed ? '已订阅' : '订阅专栏'}}</view></view><view class="weekly-description">{{weekly.description}}</view><view class="weekly-stats"><view wx:for="{{weekly.recent_users}}" wx:key="user_id" class="weekly-mini-avatar"><image src="{{item.avatar_large}}" mode="aspectFill"></image></view><text>等 {{weekly.follower_count || '0'}}人订阅 {{weekly.article_count || weekly.articles.length}}篇文章</text></view></view>
    <view class="weekly-articles surface"><view class="weekly-articles-head"><text>收录文章</text><text class="weekly-sort">默认排序　⌄</text></view><view wx:for="{{weekly.articles}}" wx:key="article_id" class="weekly-article" data-index="{{index}}" bindtap="openWeeklyArticle" aria-role="button" aria-label="阅读{{item.title}}"><view class="weekly-article-title two-lines">{{item.title}}</view><view class="weekly-article-middle"><view class="weekly-article-copy"><view class="weekly-article-meta"><image src="{{weekly.creator.avatar_large || '/assets/app/common/ic_juejin_logo.png'}}" mode="aspectFill"></image><text>{{weekly.creator.user_name}}</text><text class="industry-divider"></text><text>{{item.ctime}}</text></view><view class="weekly-article-brief two-lines">{{item.brief_content}}</view></view><image class="weekly-article-thumb" src="{{item.cover_image || weekly.cover || '/assets/app/find/find_page_ic_default_banner.png'}}" mode="aspectFill" referrer-policy="no-referrer"></image></view><view class="weekly-actions"><view><image src="/assets/app/find/find_page_ic_undigg.svg" mode="aspectFit"></image><text>{{item.digg_label}}</text></view><view><image src="/assets/app/find/find_page_ic_comment.svg" mode="aspectFit"></image><text>{{item.comment_label}}</text></view><text wx:if="{{item.tags && item.tags.length}}" class="weekly-category">{{item.tags[0]}}</text></view></view></view>
  </view>
  <empty-state wx:elif="{{!loading}}" text="未找到掘金一周内容"></empty-state>
  <view wx:if="{{loading}}" class="loading-line">正在加载...</view>
  <view wx:if="{{fromCache && !loading}}" class="cache-tip">当前网络内容暂不可用</view>
</view>
