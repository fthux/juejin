.weekly-page { min-height: 100vh; background: var(--jj-bg); }
.weekly-detail { min-height: 100vh; background: var(--jj-bg); }
.weekly-hero { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--jj-fill); }
.weekly-cover { width: 100%; height: 100%; display: block; }
.weekly-info { padding: 34rpx 32rpx 28rpx; background: var(--jj-surface); }
.weekly-title { color: var(--jj-text); font-size: 36rpx; font-weight: 700; line-height: 1.35; }
.weekly-owner { margin-top: 26rpx; display: flex; align-items: center; min-width: 0; }
.weekly-owner > image { width: 84rpx; height: 84rpx; flex: 0 0 auto; border-radius: 50%; background: var(--jj-fill); }
.weekly-owner-copy { min-width: 0; flex: 1; margin-left: 18rpx; color: var(--jj-text-2); font-size: 30rpx; }
.weekly-level { margin-left: 8rpx; padding: 3rpx 10rpx; border-radius: 5rpx; color: #fff; background: #4b79d8; font-size: 20rpx; font-weight: 700; }
.weekly-created { margin-top: 8rpx; color: var(--jj-text-3); font-size: 23rpx; }
.weekly-subscribe { width: 170rpx; height: 72rpx; margin-left: 16rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 5rpx; color: #fff; background: #1e80ff; font-size: 27rpx; }
.weekly-subscribe.followed { color: var(--jj-blue); background: var(--jj-blue-soft); }
.weekly-description { margin-top: 20rpx; color: var(--jj-text-2); font-size: 28rpx; line-height: 1.55; }
.weekly-stats { margin-top: 24rpx; display: flex; align-items: center; min-height: 44rpx; color: var(--jj-text-2); font-size: 24rpx; }
.weekly-mini-avatar { width: 48rpx; height: 48rpx; margin-right: -8rpx; overflow: hidden; border: 3rpx solid var(--jj-surface); border-radius: 50%; background: var(--jj-fill); }
.weekly-mini-avatar image { width: 100%; height: 100%; }
.weekly-stats > text { margin-left: 16rpx; }
.weekly-articles { margin-top: 18rpx; background: var(--jj-surface); }
.weekly-articles-head { height: 112rpx; padding: 0 32rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border-bottom: 1rpx solid var(--jj-line); color: var(--jj-text); font-size: 31rpx; font-weight: 600; }
.weekly-sort { color: var(--jj-blue); font-size: 25rpx; font-weight: 400; }
.weekly-article { min-height: 300rpx; padding: 34rpx 32rpx 30rpx; display: block; border-bottom: 16rpx solid var(--jj-bg); box-sizing: border-box; }
.weekly-article-title { color: var(--jj-text); font-size: 31rpx; font-weight: 600; line-height: 1.5; }
.weekly-article-middle { margin-top: 18rpx; display: flex; align-items: flex-start; min-width: 0; }
.weekly-article-copy { min-width: 0; flex: 1; }
.weekly-article-meta { margin-top: 18rpx; display: flex; align-items: center; min-width: 0; color: var(--jj-text-3); font-size: 24rpx; }
.weekly-article-middle .weekly-article-meta { margin-top: 0; }
.weekly-article-meta image { width: 42rpx; height: 42rpx; margin-right: 10rpx; border-radius: 50%; background: var(--jj-fill); }
.weekly-article-brief { margin-top: 16rpx; color: var(--jj-text-2); font-size: 27rpx; line-height: 1.55; }
.weekly-actions { width: 100%; margin-top: 20rpx; display: flex; align-items: center; color: var(--jj-text-3); font-size: 24rpx; }
.weekly-actions > view { margin-right: 30rpx; display: flex; align-items: center; }
.weekly-actions image { width: 34rpx; height: 34rpx; margin-right: 8rpx; }
.weekly-category { margin-left: auto; padding: 6rpx 14rpx; border-radius: 5rpx; color: var(--jj-text-3); background: var(--jj-fill); font-size: 22rpx; line-height: 1.2; }
.weekly-article-thumb { width: 222rpx; height: 168rpx; margin: 0 0 0 20rpx; flex: 0 0 auto; border-radius: 5rpx; background: var(--jj-fill); }
.cache-tip { padding: 22rpx; color: var(--jj-text-3); font-size: 22rpx; text-align: center; }
