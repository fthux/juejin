<view class="page course-detail-page">
  <view wx:if="{{loading}}" class="loading-line">正在加载课程...</view>
  <empty-state wx:elif="{{loadError}}" text="课程详情加载失败"></empty-state>
  <view wx:if="{{course}}" class="course-hero surface">
    <image class="course-cover" src="{{course.cover}}" mode="aspectFill"></image>
    <view class="course-copy">
      <view class="course-title">{{course.title}}</view>
      <view class="course-summary two-lines">{{course.summary}}</view>
      <view class="course-author">{{course.author}} · {{course.section_count}} 小节 · {{course.buy_count}} 人已购买</view>
      <view class="course-state">{{course.owned ? '已购课程' : '含免费试读章节'}}</view>
    </view>
  </view>
  <view class="section course-intro">
    <view class="section-header"><view class="section-title">课程介绍</view></view>
    <rich-text class="intro-copy" nodes="{{introduction}}"></rich-text>
  </view>
  <view wx:if="{{readingContent}}" id="course-reading" class="section course-reading">
    <view class="section-header"><view class="section-title">{{readingTitle}}</view></view>
    <rich-text class="reading-content" nodes="{{readingContent}}"></rich-text>
  </view>
  <view class="section chapters">
    <view class="section-header">
      <view class="section-title">课程目录</view>
      <view class="section-more">{{chapters.length}} 节</view>
    </view>
    <view wx:for="{{chapters}}" wx:key="id" class="chapter-row" data-id="{{item.id}}" bindtap="openChapter">
      <view class="chapter-copy">
        <view class="chapter-title">{{item.title}}</view>
        <view class="chapter-duration">{{item.duration}}</view>
      </view>
      <view class="chapter-state">{{item.isFree ? '免费试读' : (item.unlocked ? '阅读' : '锁定')}}</view>
    </view>
  </view>
  <view class="course-bottom safe-bottom">
    <view class="secondary-button" bindtap="toggleBookshelf">{{inBookshelf ? '移出书架' : '加入书架'}}</view>
    <view class="primary-button" bindtap="startCourse">{{course.owned ? '继续学习' : '开始试读'}}</view>
  </view>
</view>
