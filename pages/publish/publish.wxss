.publish-page {
  padding-bottom: 112rpx;
}

.publish-types {
  height: 124rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-bottom: 1rpx solid var(--jj-line);
}

.publish-type {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--jj-text-3);
}

.publish-type image {
  width: 54rpx;
  height: 54rpx;
}

.publish-type.active {
  color: #1e80ff;
  font-weight: 600;
}

.publish-type.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 50rpx;
  height: 5rpx;
  background: #1e80ff;
  transform: translateX(-50%);
}

.editor {
  margin-top: 16rpx;
  padding: 0 32rpx 30rpx;
}

.title-input {
  height: 104rpx;
  border-bottom: 1rpx solid var(--jj-line);
  color: var(--jj-text);
  font-size: 36rpx;
  font-weight: 600;
}

.content-input {
  width: 100%;
  height: 440rpx;
  padding-top: 30rpx;
  box-sizing: border-box;
  color: var(--jj-text);
  font-size: 30rpx;
  line-height: 1.7;
}

.article-input {
  height: 640rpx;
}

.tag-input-row {
  height: 76rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 6rpx;
  color: #1e80ff;
  background: var(--jj-fill);
}

.tag-input-row input {
  flex: 1;
  color: var(--jj-text-2);
}

.editor-foot {
  margin-top: 20rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
  text-align: right;
}

.publish-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 104rpx;
  padding: 14rpx 24rpx;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 18rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  border-top: 1rpx solid var(--jj-line);
}
