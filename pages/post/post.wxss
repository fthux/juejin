.post-page {
  padding-bottom: 116rpx;
}

.article-detail {
  padding: 42rpx 32rpx 48rpx;
}

.detail-title {
  color: var(--jj-text);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
}

.author-row {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
}

.author-copy {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
}

.author-name {
  color: var(--jj-text);
  font-size: 27rpx;
  font-weight: 600;
}

.author-meta {
  margin-top: 6rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.follow-button {
  min-width: 116rpx;
  height: 60rpx;
  padding: 0 18rpx;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #ffffff;
  background: #1e80ff;
  font-size: 24rpx;
}

.follow-button.followed {
  color: var(--jj-text-3);
  background: var(--jj-fill);
}

.article-content {
  margin-top: 44rpx;
  color: var(--jj-text);
  font-size: 31rpx;
  line-height: 1.85;
  word-break: break-word;
}

.article-content rich-text {
  display: block;
  overflow: hidden;
}

.content-error {
  padding: 72rpx 24rpx;
  color: var(--jj-text-3);
  background: var(--jj-fill-2);
  text-align: center;
  font-size: 26rpx;
}

.page-error {
  min-height: 420rpx;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.content-error .text-button {
  margin-top: 20rpx;
}

.article-tags {
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.local-comment {
  padding: 26rpx 32rpx;
  display: flex;
  border-top: 1rpx solid var(--jj-line);
}

.local-comment .avatar {
  width: 64rpx;
  height: 64rpx;
}

.local-comment-copy {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
  color: var(--jj-text-2);
  font-size: 24rpx;
}

.local-comment-copy > text {
  display: block;
  margin-top: 10rpx;
  color: var(--jj-text);
  font-size: 28rpx;
  line-height: 1.55;
}

.local-comment-time {
  margin-top: 10rpx;
  color: var(--jj-text-3);
  font-size: 21rpx;
}

.comment-empty {
  padding: 34rpx 32rpx;
  color: var(--jj-text-3);
  border-top: 1rpx solid var(--jj-line);
  text-align: center;
  font-size: 24rpx;
}

.action-bar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 100rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  border-top: 1rpx solid var(--jj-line);
}

.comment-entry {
  height: 64rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  flex: 1;
  border-radius: 6rpx;
  color: var(--jj-text-3);
  background: var(--jj-fill);
  font-size: 24rpx;
}

.action {
  width: 94rpx;
  height: 76rpx;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-3);
  background: transparent;
  font-size: 20rpx;
  line-height: 1.2;
}

.action-icon {
  margin-bottom: 4rpx;
  color: var(--jj-text-2);
  font-size: 30rpx;
}

.action.active,
.action.active .action-icon {
  color: #1e80ff;
}

.share-action {
  margin: 0;
  border-radius: 0;
}
