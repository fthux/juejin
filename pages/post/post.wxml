<view class="page post-page">
  <view wx:if="{{article}}" class="article-detail surface">
    <view class="detail-title">{{article.title}}</view>
    <view class="author-row">
      <image class="avatar" src="{{article.author.avatar_large}}" mode="aspectFill" bindtap="openAuthor"></image>
      <view class="author-copy" bindtap="openAuthor">
        <view class="author-name">{{article.author.user_name}}</view>
        <view class="author-meta">{{article.ctime}} · 阅读 {{article.view_count}}</view>
      </view>
      <view class="follow-button {{isFollowed ? 'followed' : ''}}" bindtap="toggleFollow">{{isFollowed ? '已关注' : '关注'}}</view>
    </view>
    <view class="article-content">
      <rich-text wx:if="{{content}}" nodes="{{content}}" user-select></rich-text>
      <view wx:if="{{loadError}}" class="content-error">
        <view>正文加载失败，请检查网络后重试</view>
        <view class="text-button" bindtap="retry">重新加载</view>
      </view>
    </view>
    <view class="article-tags">
      <view wx:for="{{article.tags}}" wx:key="*this" class="chip">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{loadError && !article}}" class="content-error page-error surface">
    <view>未能加载这篇文章，请检查网络后重试</view>
    <view class="text-button" bindtap="retry">重新加载</view>
  </view>

  <view wx:if="{{article}}" class="section">
    <view class="section-header">
      <view class="section-title">评论 · {{comments.length}}</view>
    </view>
    <view wx:for="{{comments}}" wx:key="id" class="local-comment">
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="local-comment-copy"><view>{{item.user}}</view><text>{{item.content}}</text><view class="local-comment-time">{{item.time}}</view></view>
    </view>
    <view wx:if="{{!comments.length}}" class="comment-empty">还没有评论，来说两句吧</view>
  </view>

  <view wx:if="{{article}}" class="section">
    <view class="section-header">
      <view class="section-title">相关推荐</view>
    </view>
    <article-card wx:for="{{related}}" wx:key="article_id" item="{{item}}" bind:open="openRelated"></article-card>
  </view>
  <view wx:if="{{loading}}" class="loading-line">正在加载文章...</view>

  <view wx:if="{{article}}" class="action-bar safe-bottom">
    <view class="comment-entry" bindtap="addComment">写评论...</view>
    <view class="action {{isLiked ? 'active' : ''}}" bindtap="toggleLike">
      <text class="action-icon">△</text>
      <text>{{isLiked ? article.digg_count + 1 : article.digg_count}}</text>
    </view>
    <view class="action {{isCollected ? 'active' : ''}}" bindtap="toggleCollect">
      <text class="action-icon">☆</text>
      <text>{{isCollected ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="action share-action" open-type="share">
      <text class="action-icon">↗</text>
      <text>分享</text>
    </button>
  </view>
</view>
