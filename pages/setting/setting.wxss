.setting-page {
  padding-top: 1rpx;
}

.setting-group {
  margin-top: 16rpx;
}

.setting-row {
  min-height: 98rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: var(--jj-text);
  border-bottom: 1rpx solid var(--jj-line);
}

.setting-value {
  color: var(--jj-text-3);
  font-size: 25rpx;
}

.logout-button {
  height: 92rpx;
  margin: 32rpx 24rpx;
  border-radius: 6rpx;
  color: #f53f3f;
  background: var(--jj-surface);
  font-size: 28rpx;
  line-height: 92rpx;
}
