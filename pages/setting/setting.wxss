.setting-page {
  padding: 1rpx 0 80rpx;
  background: var(--jj-bg);
}

.setting-page.dark-preview {
  --jj-text: #f2f3f5;
  --jj-text-3: #9b9fa8;
  --jj-line: #303136;
  --jj-surface: #191a1c;
  --jj-bg: #0d0e10;
  min-height: 100vh;
}

.setting-group {
  margin-top: 16rpx;
}

.setting-row {
  min-height: 98rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: var(--jj-text);
  border-bottom: 1rpx solid var(--jj-line);
  font-size: 28rpx;
}

.setting-row switch {
  transform: scale(0.78);
  transform-origin: right center;
}

.setting-value,
.arrow {
  color: var(--jj-text-3);
}

.arrow {
  margin-left: 8rpx;
  font-size: 42rpx;
  font-weight: 200;
}

.version {
  margin-top: 28rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
  text-align: center;
}
