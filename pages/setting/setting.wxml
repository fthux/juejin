<view class="page setting-page">
  <view class="setting-group surface">
    <view class="setting-row">
      <text>深色模式</text>
      <switch checked="{{darkMode}}" color="#1e80ff" bindchange="toggleDark"></switch>
    </view>
    <view class="setting-row" bindtap="changeFont">
      <text>字体大小</text>
      <view class="setting-value">{{fontSize}} ›</view>
    </view>
  </view>
  <view class="setting-group surface">
    <navigator class="setting-row" url="/pages/notifications/notifications">
      <text>消息设置</text><view class="setting-value">›</view>
    </navigator>
    <view class="setting-row" bindtap="clearCache">
      <text>清理缓存</text><view class="setting-value">›</view>
    </view>
  </view>
  <view class="setting-group surface">
    <navigator class="setting-row" url="/pages/about/about">
      <text>关于稀土掘金</text><view class="setting-value">›</view>
    </navigator>
    <view class="setting-row">
      <text>版本</text><view class="setting-value">{{version}}</view>
    </view>
  </view>
  <button wx:if="{{loggedIn}}" class="logout-button" bindtap="logout">退出登录</button>
</view>
