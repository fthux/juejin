.notice-grid {
  padding: 34rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.notice-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: var(--jj-text-2);
  font-size: 23rpx;
}

.notice-icon {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-weight: 600;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #f53f3f;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.conversation {
  min-height: 132rpx;
  padding: 22rpx 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-top: 1rpx solid var(--jj-line);
}

.conversation-copy {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.conversation-title {
  color: var(--jj-text);
  font-size: 28rpx;
  font-weight: 600;
}

.conversation-preview,
.conversation-time {
  margin-top: 8rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.conversation-time {
  margin: 0 0 0 16rpx;
}

.notice-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #c9cdd4;
}

.notice-dot.unread {
  background: #1e80ff;
}
