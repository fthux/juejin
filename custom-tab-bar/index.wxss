.app-tab-bar {
  position: relative;
  width: 100%;
  min-height: var(--jj-tabbar-height, 104rpx);
  padding-top: 8rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(134, 144, 156, 0.18);
  background: #ffffff;
}

.tab-item {
  width: 20%;
  height: var(--jj-touch-target, 88rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: #8a919f;
  font-size: 24rpx;
  line-height: 28rpx;
}

.tab-pressed {
  opacity: 0.58;
}

.tab-item.active {
  color: #1e80ff;
}

.tab-icon-box {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-icon.profile-normal {
  border: 3rpx solid #252933;
  border-radius: 50%;
  box-sizing: border-box;
}

@media (prefers-color-scheme: dark) {
  .app-tab-bar {
    border-top-color: #2c2d30;
    background: #17181a;
  }

  .tab-item {
    color: #c9cdd4;
  }

  .tab-item.active {
    color: #1e80ff;
  }

  .tab-icon.profile-normal {
    border-color: #ffffff;
  }
}

.app-tab-bar.light-mode {
  border-top-color: rgba(134, 144, 156, 0.18);
  background: #ffffff;
}

.app-tab-bar.light-mode .tab-item {
  color: #8a919f;
}

.app-tab-bar.light-mode .tab-icon.profile-normal {
  border-color: #252933;
}

.app-tab-bar.dark-mode {
  border-top-color: #2c2d30;
  background: #17181a;
}

.app-tab-bar.dark-mode .tab-item {
  color: #c9cdd4;
}

.app-tab-bar.dark-mode .tab-item.active {
  color: #1e80ff;
}

.app-tab-bar.dark-mode .tab-icon.profile-normal {
  border-color: #ffffff;
}
