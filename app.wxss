page {
  --jj-blue: #1e80ff;
  --jj-blue-soft: #eaf2ff;
  --jj-green: #00b578;
  --jj-red: #f53f3f;
  --jj-gold: #ff9f1a;
  --jj-success-soft: #e8f8f2;
  --jj-danger-soft: #fff0f0;
  --jj-warning-soft: #fff7e8;
  --jj-overlay: rgba(0, 0, 0, 0.48);
  --jj-disabled-opacity: 0.46;
  --jj-text: #252933;
  --jj-text-2: #515767;
  --jj-text-3: #8a919f;
  --jj-line: #e5e6eb;
  --jj-surface: #ffffff;
  --jj-bg: #f4f5f5;
  --jj-fill: #f2f3f5;
  --jj-fill-2: #f7f8fa;
  --jj-text-4: #c9cdd4;
  --jj-font-caption: 24rpx;
  --jj-font-body: 28rpx;
  --jj-font-body-lg: 30rpx;
  --jj-font-title: 32rpx;
  --jj-line-caption: 1.5;
  --jj-line-body: 1.6;
  --jj-space-1: 8rpx;
  --jj-space-2: 12rpx;
  --jj-space-3: 16rpx;
  --jj-space-4: 24rpx;
  --jj-space-5: 32rpx;
  --jj-radius-sm: 4rpx;
  --jj-radius-md: 6rpx;
  --jj-radius-lg: 8rpx;
  --jj-touch-target: 88rpx;
  --jj-tabbar-height: 104rpx;
  --jj-safe-bottom: env(safe-area-inset-bottom);
  min-height: 100%;
  background: var(--jj-bg);
  color: var(--jj-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
  -webkit-font-smoothing: antialiased;
}

@media (prefers-color-scheme: dark) {
  page {
    --jj-blue-soft: rgba(30, 128, 255, 0.18);
    --jj-text: #f2f3f5;
    --jj-text-2: #c9cdd4;
    --jj-text-3: #8f959e;
    --jj-text-4: #6b7280;
    --jj-line: #333438;
    --jj-surface: #17181a;
    --jj-bg: #111214;
    --jj-fill: #25262a;
    --jj-fill-2: #202125;
    --jj-success-soft: rgba(0, 181, 120, 0.16);
    --jj-danger-soft: rgba(245, 63, 63, 0.16);
    --jj-warning-soft: rgba(255, 159, 26, 0.16);
    --jj-overlay: rgba(0, 0, 0, 0.7);
  }
}

button,
input,
textarea {
  font: inherit;
  letter-spacing: 0;
}

button::after {
  border: 0;
}

image {
  display: block;
}

::-webkit-scrollbar {
  display: none;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.surface {
  background: var(--jj-surface);
}

.section {
  margin-top: 16rpx;
  background: var(--jj-surface);
}

.section-header {
  min-height: 92rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--jj-text);
}

.section-more {
  color: var(--jj-text-3);
  font-size: 25rpx;
}

.divider {
  height: 1rpx;
  background: var(--jj-line);
}

.tabs {
  height: 88rpx;
  display: flex;
  align-items: stretch;
  background: var(--jj-surface);
  border-bottom: 1rpx solid var(--jj-line);
  box-sizing: border-box;
}

.tab {
  position: relative;
  min-width: 108rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jj-text-2);
  font-size: 28rpx;
  box-sizing: border-box;
}

.tab.active {
  color: var(--jj-blue);
  font-weight: 600;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 34rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: var(--jj-blue);
  transform: translateX(-50%);
}

.primary-button,
.secondary-button,
.text-button {
  min-height: var(--jj-touch-target);
  padding: 0 30rpx;
  border-radius: 6rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1;
}

.interactive-pressed {
  opacity: 0.7;
  transform: scale(0.985);
}

.is-disabled,
button[disabled] {
  opacity: var(--jj-disabled-opacity);
  pointer-events: none;
}

.is-loading {
  cursor: wait;
  opacity: 0.72;
  pointer-events: none;
}

.primary-button {
  color: #ffffff;
  background: var(--jj-blue);
}

.secondary-button {
  color: var(--jj-blue);
  background: var(--jj-blue-soft);
}

.text-button {
  color: var(--jj-blue);
  background: transparent;
}

.chip {
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 4rpx;
  display: inline-flex;
  align-items: center;
  color: var(--jj-text-2);
  background: var(--jj-fill);
  font-size: 24rpx;
}

.chip.active {
  color: var(--jj-blue);
  background: var(--jj-blue-soft);
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--jj-fill);
}

.muted {
  color: var(--jj-text-3);
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-nav, .weekly-nav { width: 100%; height: 100%; padding: 0 30rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; }
.channel-nav { color: var(--jj-text); background: var(--jj-surface); }
.channel-nav > text { font-size: 34rpx; font-weight: 600; }
.nav-back { width: 70rpx; font-size: 64rpx; line-height: 1; }
.nav-placeholder { width: 70rpx; }
.nav-more { font-size: 32rpx; }
.industry-list { padding: 0 30rpx; }
.industry-row { min-height: 350rpx; padding: 30rpx 0; display: flex; border-bottom: 1rpx solid var(--jj-line); box-sizing: border-box; }
.industry-copy { min-width: 0; flex: 1; }
.industry-title { color: var(--jj-text); font-size: 30rpx; font-weight: 600; line-height: 1.45; }
.industry-meta { margin-top: 16rpx; display: flex; align-items: center; color: var(--jj-text-3); font-size: 23rpx; }
.industry-meta image { width: 38rpx; height: 38rpx; margin-right: 10rpx; border-radius: 50%; background: var(--jj-fill); }
.industry-divider { width: 1rpx; height: 24rpx; margin: 0 14rpx; background: var(--jj-line); }
.industry-brief { margin-top: 16rpx; color: var(--jj-text-2); font-size: 25rpx; line-height: 1.58; }
.industry-actions, .weekly-actions { margin-top: 20rpx; display: flex; gap: 42rpx; color: var(--jj-text-3); font-size: 23rpx; }
.industry-actions > view, .weekly-actions > view { display: flex; align-items: center; gap: 8rpx; }
.industry-actions image, .weekly-actions image { width: 31rpx; height: 31rpx; }
.industry-thumb { width: 192rpx; height: 144rpx; margin: 116rpx 0 0 20rpx; flex: 0 0 auto; border-radius: 8rpx; background: #2b2b2b; }
.industry-thumb.placeholder { display: block; }
.weekly-detail { min-height: 100vh; background: var(--jj-bg); }
.weekly-hero { position: relative; height: 550rpx; overflow: hidden; background: #182038; }
.weekly-cover { position: absolute; inset: 0; width: 100%; height: 100%; }
.weekly-nav { position: relative; z-index: 1; color: #fff; }
.weekly-info { position: relative; z-index: 2; margin-top: -1rpx; padding: 38rpx 42rpx 28rpx; background: var(--jj-surface); }
.weekly-title { color: var(--jj-text); font-size: 38rpx; font-weight: 600; }
.weekly-owner { min-height: 88rpx; margin-top: 22rpx; display: flex; align-items: center; }
.weekly-owner > image { width: 76rpx; height: 76rpx; margin-right: 16rpx; border-radius: 50%; background: var(--jj-fill); }
.weekly-owner-copy { min-width: 0; flex: 1; color: var(--jj-text); font-size: 30rpx; }
.weekly-created { margin-top: 8rpx; color: var(--jj-text-3); font-size: 24rpx; }
.weekly-level { margin-left: 8rpx; padding: 2rpx 8rpx; border-radius: 4rpx; color: #fff; background: #2d8cff; font-size: 18rpx; font-style: italic; }
.weekly-subscribe { width: 160rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 5rpx; color: #fff; background: #1e80ff; font-size: 28rpx; }
.weekly-subscribe.followed { color: var(--jj-text-2); background: var(--jj-fill); }
.weekly-description { margin-top: 18rpx; color: var(--jj-text); font-size: 27rpx; line-height: 1.5; }
.weekly-stats { min-height: 56rpx; margin-top: 20rpx; display: flex; align-items: center; color: var(--jj-text-2); font-size: 26rpx; }
.weekly-mini-avatar { width: 48rpx; height: 48rpx; margin-left: -10rpx; overflow: hidden; border: 2rpx solid var(--jj-surface); border-radius: 50%; background: var(--jj-fill); }
.weekly-mini-avatar:first-child { margin-left: 0; }
.weekly-mini-avatar image { width: 100%; height: 100%; }
.weekly-stats > text { margin-left: 14rpx; }
.weekly-articles { margin-top: 16rpx; }
.weekly-articles-head { height: 102rpx; padding: 0 42rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--jj-line); color: var(--jj-text); font-size: 31rpx; font-weight: 600; }
.weekly-sort { color: var(--jj-blue); font-size: 27rpx; font-weight: 400; }
.weekly-article { min-height: 320rpx; padding: 30rpx 42rpx; display: flex; border-bottom: 1rpx solid var(--jj-line); box-sizing: border-box; }
.weekly-article-copy { min-width: 0; flex: 1; }
.weekly-article-title { color: var(--jj-text); font-size: 30rpx; font-weight: 600; line-height: 1.45; }
.weekly-article-meta { margin-top: 16rpx; display: flex; align-items: center; color: var(--jj-text-3); font-size: 24rpx; }
.weekly-article-meta image { width: 38rpx; height: 38rpx; margin-right: 10rpx; border-radius: 50%; background: var(--jj-fill); }
.weekly-article-brief { margin-top: 15rpx; color: var(--jj-text-2); font-size: 25rpx; line-height: 1.58; }
.weekly-article-thumb { width: 198rpx; height: 154rpx; margin: 116rpx 0 0 20rpx; flex: 0 0 auto; border-radius: 6rpx; background: var(--jj-fill); }
.channel-page.dark .channel-nav { background: #17181a; }
.channel-page.dark .industry-thumb.placeholder { background: #2b2b2b; }
.channel-page.dark .weekly-info, .channel-page.dark .weekly-articles { background: #17181a; }
.channel-page.dark .weekly-detail { background: #111214; }

.two-lines {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.empty-view {
  min-height: 460rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--jj-text-3);
  text-align: center;
}

.empty-view image {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 24rpx;
}

.loading-line {
  padding: 28rpx;
  color: var(--jj-text-3);
  text-align: center;
  font-size: var(--jj-font-caption);
  line-height: var(--jj-line-caption);
}
