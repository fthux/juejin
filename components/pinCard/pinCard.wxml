<view class="pin-card {{compact ? 'compact' : ''}} {{showActions ? '' : 'without-actions'}}" hover-class="card-pressed" hover-stay-time="80" bindtap="open" aria-role="button" aria-label="查看{{item.author.user_name}}发布的沸点">
  <view class="pin-head">
    <view class="avatar-action" hover-class="item-pressed" catchtap="openAuthor" aria-role="button" aria-label="查看{{item.author.user_name}}的主页">
      <image class="avatar" src="{{authorAvatarFailed ? '/assets/app/common/default_avatar.png' : item.author.avatar_large}}" mode="aspectFill" referrer-policy="no-referrer" binderror="onAuthorAvatarError" aria-hidden="true"></image>
    </view>
    <view class="identity">
      <view class="name ellipsis">{{item.author.user_name}}</view>
      <view class="caption">
        <text wx:if="{{item.author.job_title || item.author.company}}" class="caption-role ellipsis">{{item.author.job_title}}{{item.author.job_title && item.author.company ? ' @ ' : ''}}{{item.author.company}}</text>
        <text wx:if="{{item.ctime}}" class="publish-time">{{item.author.job_title || item.author.company ? ' · ' : ''}}{{item.ctime}}</text>
      </view>
    </view>
    <view wx:if="{{showFollow}}" class="card-follow {{followed ? 'followed' : ''}}" hover-class="item-pressed" catchtap="follow" aria-role="button" aria-label="{{followed ? '取消关注' : '关注'}}{{item.author.user_name}}">{{followed ? '已关注' : '关注'}}</view>
    <view wx:elif="{{showMore}}" class="more-action" hover-class="item-pressed" catchtap="more" aria-role="button" aria-label="更多操作">
      <image class="more" src="/assets/app/pins/ic_pin_more.png" mode="aspectFit" aria-hidden="true"></image>
    </view>
  </view>
  <view class="pin-content-wrap">
    <view class="pin-content pin-content-visible {{contentCollapsible && !contentExpanded ? 'collapsed' : 'expanded'}}">
      <block wx:if="{{item.content_segments.length}}">
        <block wx:for="{{item.content_segments}}" wx:key="key">
          <text wx:if="{{item.type === 'theme'}}" class="pin-theme-link" data-index="{{index}}" hover-class="item-pressed" catchtap="openTheme" aria-role="button" aria-label="打开活动{{item.text}}">#{{item.text}}#</text>
          <text wx:else>{{item.text}}</text>
        </block>
      </block>
      <text wx:else>{{item.content}}</text>
    </view>
    <view wx:if="{{contentCollapsible}}" class="pin-content pin-content-measure" aria-hidden="true">
      <block wx:if="{{item.content_segments.length}}">
        <block wx:for="{{item.content_segments}}" wx:key="key">
          <text wx:if="{{item.type === 'theme'}}">#{{item.text}}#</text>
          <text wx:else>{{item.text}}</text>
        </block>
      </block>
      <text wx:else>{{item.content}}</text>
    </view>
  </view>
  <view wx:if="{{contentCollapsible && contentCanToggle}}" class="content-toggle" hover-class="item-pressed" catchtap="toggleContent" aria-role="button" aria-label="{{contentExpanded ? '收起沸点正文' : '展开沸点正文'}}">{{contentExpanded ? '收起' : '展开'}}</view>
  <view wx:if="{{item.pic_list.length}}" class="pin-pictures">
    <view wx:for="{{item.pic_list}}" wx:key="*this" class="pin-picture-action" data-src="{{item}}" hover-class="item-pressed" catchtap="previewImage" aria-role="button" aria-label="预览图片">
      <image class="pin-picture" src="{{item}}" mode="aspectFill" aria-hidden="true"></image>
    </view>
  </view>
  <view wx:if="{{item.link}}" class="pin-link">
    <view class="link-icon">↗</view>
    <view class="link-copy">
      <view class="link-title ellipsis">{{item.link_title || item.link}}</view>
      <view class="link-host ellipsis">{{item.link}}</view>
    </view>
  </view>
  <view wx:if="{{item.hot_comment}}" class="hot-comment">
    <view class="hot-comment-head">
      <image class="hot-comment-label" src="/assets/app/pins/ic_pins_hot_comment.png" mode="aspectFit"></image>
      <text wx:if="{{item.hot_comment.digg_count_value > 0}}" class="hot-comment-digg">{{item.hot_comment.digg_count}}人赞</text>
    </view>
    <view class="hot-comment-content">{{item.hot_comment.content}}</view>
  </view>
  <view wx:if="{{(item.topic && item.topic_id) || (item.digg_count_value > 0 && item.digg_users.length)}}" class="pin-meta-row">
    <view wx:if="{{item.topic && item.topic_id}}" class="topic" hover-class="item-pressed" catchtap="openTopic" aria-role="button" aria-label="打开{{item.topic}}圈子"># {{item.topic}} ></view>
    <view wx:if="{{item.digg_count_value > 0 && item.digg_users.length}}" class="pin-digg-users">
      <view class="pin-digg-avatars">
        <image wx:for="{{item.digg_users}}" wx:key="user_id" class="pin-digg-avatar" src="{{failedDiggAvatars[index] ? '/assets/app/common/default_avatar.png' : item.avatar_large}}" mode="aspectFill" referrer-policy="no-referrer" data-index="{{index}}" binderror="onDiggAvatarError"></image>
      </view>
      <text>{{item.digg_users.length <= 10 ? "赞过" : "等人赞过"}}</text>
    </view>
  </view>
  <view wx:if="{{showActions}}" class="pin-actions">
    <button class="pin-action" open-type="share" data-item="{{item}}" hover-class="action-pressed" catchtap="noop" aria-label="分享沸点"><image class="pin-action-icon" src="/assets/app/pins/ic_pins_share.png" mode="aspectFit"></image><text>分享</text></button>
    <view class="pin-action" hover-class="action-pressed" aria-role="button" aria-label="查看评论"><image class="pin-action-icon" src="/assets/app/pins/ic_pins_comment.png" mode="aspectFit"></image><text>{{item.comment_count_value > 0 ? item.comment_count : '评论'}}</text></view>
    <view class="pin-action {{item.is_digg ? 'liked' : ''}}" hover-class="action-pressed" catchtap="like" aria-role="button" aria-label="{{item.is_digg ? '取消点赞' : '点赞'}}"><image class="pin-action-icon" src="{{item.is_digg ? '/assets/app/find/find_page_ic_digg.svg' : '/assets/app/find/find_page_ic_undigg.svg'}}" mode="aspectFit"></image><text>{{item.digg_count_value > 0 ? item.digg_count : '点赞'}}</text></view>
  </view>
</view>
