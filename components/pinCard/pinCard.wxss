.pin-card {
  padding: 28rpx 32rpx 0;
  background: var(--jj-surface);
  border-bottom: 16rpx solid var(--jj-bg);
}

.card-pressed {
  opacity: 0.72;
  background: var(--jj-fill-2);
}

.item-pressed,
.action-pressed {
  opacity: 0.58;
}

.pin-card.without-actions {
  padding-bottom: 38rpx;
}

.pin-head {
  display: flex;
  align-items: center;
}

.avatar-action {
  width: var(--jj-touch-target);
  height: var(--jj-touch-target);
  margin: -8rpx 0;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--jj-fill);
}

.identity {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
}

.name {
  color: var(--jj-text);
  font-size: 28rpx;
  font-weight: 600;
}

.caption {
  margin-top: 6rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  color: var(--jj-text-3);
  font-size: var(--jj-font-caption);
}

.caption-role {
  min-width: 0;
}

.publish-time {
  flex: none;
  white-space: nowrap;
}

.more-action {
  width: var(--jj-touch-target);
  height: var(--jj-touch-target);
  margin: -8rpx -28rpx -8rpx 0;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.more {
  width: 32rpx;
  height: 32rpx;
}

.card-follow {
  min-width: 112rpx;
  height: 64rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--jj-blue);
  border-radius: 4rpx;
  color: var(--jj-blue);
  font-size: var(--jj-font-caption);
}

.card-follow.followed {
  border-color: var(--jj-line);
  color: var(--jj-text-3);
}

.pin-content {
  margin: 20rpx 0 16rpx;
  color: var(--jj-text);
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}

.pin-theme-link {
  color: var(--jj-blue);
}

.pin-pictures {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.pin-picture-action,
.pin-picture {
  width: 100%;
  height: 210rpx;
}

.pin-picture-action {
  overflow: hidden;
  border-radius: 4rpx;
  background: var(--jj-fill);
}

.pin-link {
  min-height: 104rpx;
  margin-top: 16rpx;
  padding: 14rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: var(--jj-fill);
}

.link-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: var(--jj-blue);
  font-size: 34rpx;
}

.link-copy {
  min-width: 0;
  margin-left: 16rpx;
  flex: 1;
}

.link-title {
  color: var(--jj-text-2);
  font-size: var(--jj-font-caption);
}

.link-host {
  margin-top: 8rpx;
  color: var(--jj-text-3);
  font-size: var(--jj-font-caption);
}

.topic {
  width: fit-content;
  min-height: 64rpx;
  margin-top: 18rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-radius: 20rpx;
  color: #1e80ff;
  background: var(--jj-blue-soft);
  font-size: 25rpx;
}

.hot-comment {
  margin-top: 18rpx;
  padding: 18rpx 22rpx 20rpx;
  color: var(--jj-text-2);
  background: var(--jj-fill);
}

.hot-comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hot-comment-label {
  width: 86rpx;
  height: 40rpx;
  flex: none;
}

.hot-comment-digg {
  color: var(--jj-text-3);
  font-size: var(--jj-font-caption);
}

.hot-comment-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.pin-digg-users {
  min-height: 64rpx;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--jj-text-3);
  font-size: var(--jj-font-caption);
}

.pin-digg-avatars {
  margin-right: 12rpx;
  display: flex;
}

.pin-digg-avatar {
  width: 42rpx;
  height: 42rpx;
  margin-left: -10rpx;
  border: 3rpx solid var(--jj-surface);
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--jj-fill);
}

.pin-digg-avatar:first-child {
  margin-left: 0;
}

.pin-actions {
  height: 88rpx;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  color: var(--jj-text-3);
  border-top: 1rpx solid var(--jj-line);
  font-size: 25rpx;
  text-align: center;
}

.pin-action {
  width: 0;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  padding: 0;
  flex: 1 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: inherit;
  background: transparent;
  font-size: inherit;
  line-height: 1;
  box-sizing: border-box;
}

.pin-action:first-child {
  justify-content: center;
}

.pin-action:last-child {
  justify-content: center;
}

.pin-action-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.78;
}

.liked {
  color: #1e80ff;
}

.pin-card.compact {
  padding: 24rpx 28rpx 0;
  border-bottom-width: 14rpx;
  border-bottom-color: var(--jj-bg);
}

.compact .avatar {
  width: 62rpx;
  height: 62rpx;
}

.compact .name {
  font-size: 26rpx;
}

.compact .caption {
  font-size: var(--jj-font-caption);
}

.compact .pin-content {
  margin: 16rpx 0;
  font-size: var(--jj-font-body);
  line-height: 1.58;
}

.compact .pin-actions,
.compact .pin-action {
  height: var(--jj-touch-target);
}
