.pin-card {
  padding: 28rpx 32rpx 0;
  background: var(--jj-surface);
  border-bottom: 16rpx solid var(--jj-bg);
}

.pin-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--jj-fill);
}

.identity {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
}

.name {
  color: var(--jj-text);
  font-size: 28rpx;
  font-weight: 600;
}

.caption {
  margin-top: 6rpx;
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.more {
  padding: 12rpx;
  color: var(--jj-text-3);
}

.card-follow {
  height: 50rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--jj-blue);
  border-radius: 4rpx;
  color: var(--jj-blue);
  font-size: 21rpx;
}

.card-follow.followed {
  border-color: var(--jj-line);
  color: var(--jj-text-3);
}

.pin-content {
  margin: 20rpx 0;
  color: var(--jj-text);
  font-size: 30rpx;
  line-height: 1.65;
  word-break: break-all;
}

.pin-pictures {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.pin-picture {
  width: 100%;
  height: 210rpx;
  border-radius: 4rpx;
  background: var(--jj-fill);
}

.topic {
  margin-top: 18rpx;
  color: #1e80ff;
  font-size: 25rpx;
}

.pin-actions {
  height: 88rpx;
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
  color: var(--jj-text-3);
  border-top: 1rpx solid var(--jj-line);
  font-size: 25rpx;
  text-align: center;
}

.pin-action {
  height: 88rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: inherit;
  background: transparent;
  font-size: inherit;
  line-height: 1;
}

.pin-action image {
  width: 28rpx;
  height: 28rpx;
}

.liked {
  color: #1e80ff;
}

.pin-card.compact {
  padding: 22rpx 24rpx 0;
  border-bottom-width: 1rpx;
  border-bottom-color: var(--jj-line);
}

.compact .avatar {
  width: 62rpx;
  height: 62rpx;
}

.compact .name {
  font-size: 26rpx;
}

.compact .caption {
  font-size: 21rpx;
}

.compact .pin-content {
  margin: 16rpx 0;
  font-size: 27rpx;
  line-height: 1.58;
}

.compact .pin-actions,
.compact .pin-action {
  height: 72rpx;
}
