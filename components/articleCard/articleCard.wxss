.article-card {
  min-height: 246rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-bottom: 1rpx solid #e5e6eb;
}

.article-main {
  min-width: 0;
  flex: 1;
}

.article-meta,
.article-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #8a919f;
  font-size: 23rpx;
}

.author {
  max-width: 200rpx;
  overflow: hidden;
  color: #515767;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  max-width: 120rpx;
  padding-left: 12rpx;
  overflow: hidden;
  border-left: 1rpx solid #e5e6eb;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-title {
  margin-top: 16rpx;
  color: #252933;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.42;
}

.article-brief {
  margin-top: 10rpx;
  color: #8a919f;
  font-size: 25rpx;
  line-height: 1.55;
}

.article-stats {
  margin-top: 18rpx;
  gap: 30rpx;
}

.article-cover {
  width: 180rpx;
  height: 120rpx;
  flex: 0 0 auto;
  border-radius: 4rpx;
  background: #f2f3f5;
}

.rank {
  width: 36rpx;
  color: #8a919f;
  font-size: 28rpx;
  font-weight: 700;
  font-style: italic;
}

.rank-1 { color: #f53f3f; }
.rank-2 { color: #ff7d00; }
.rank-3 { color: #ffb400; }
