.article-card {
  min-height: 246rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  border-bottom: 1rpx solid var(--jj-line);
}

.card-pressed {
  opacity: 0.72;
  background: var(--jj-fill-2);
}

.item-pressed {
  opacity: 0.58;
}

.article-main {
  min-width: 0;
  flex: 1;
}

.article-meta,
.article-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--jj-text-3);
  font-size: var(--jj-font-caption);
}

.article-stats .stat {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.article-stats .stat-icon {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 auto;
}

.author {
  max-width: 200rpx;
  overflow: hidden;
  color: var(--jj-text-2);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  max-width: 120rpx;
  padding-left: 12rpx;
  overflow: hidden;
  border-left: 1rpx solid var(--jj-line);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-title {
  margin-top: 16rpx;
  display: -webkit-box;
  overflow: hidden;
  color: var(--jj-text);
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.42;
}

.article-brief {
  margin-top: 10rpx;
  display: -webkit-box;
  overflow: hidden;
  color: var(--jj-text-3);
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 25rpx;
  line-height: 1.55;
}

.article-stats {
  margin-top: 18rpx;
  gap: 30rpx;
}

.article-cover {
  width: 180rpx;
  height: 120rpx;
  flex: 0 0 auto;
  border-radius: 4rpx;
  background: var(--jj-fill);
}

.rank {
  width: 36rpx;
  color: var(--jj-text-3);
  font-size: 28rpx;
  font-weight: 700;
  font-style: italic;
}

.rank-1 { color: #f53f3f; }
.rank-2 { color: #ff7d00; }
.rank-3 { color: #ffb400; }

.article-card.compact {
  min-height: 194rpx;
  padding: 22rpx 24rpx;
  gap: 18rpx;
}

.compact .article-meta,
.compact .article-stats {
  font-size: var(--jj-font-caption);
}

.compact .article-title {
  margin-top: 12rpx;
  font-size: 28rpx;
}

.compact .article-brief {
  margin-top: 8rpx;
  font-size: var(--jj-font-caption);
  -webkit-line-clamp: 1;
}

.compact .article-stats {
  margin-top: 12rpx;
  gap: 22rpx;
}

.compact .article-cover {
  width: 150rpx;
  height: 100rpx;
}

.article-card.home-card {
  min-height: 286rpx;
  padding: 24rpx 30rpx 22rpx;
  align-items: stretch;
  border-bottom: 14rpx solid var(--jj-bg);
}

.home-main {
  width: 100%;
}

.home-card .article-title {
  margin-top: 0;
  font-size: 30rpx;
  line-height: 1.42;
}

.home-author-row {
  min-height: 56rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  color: var(--jj-text-3);
  font-size: var(--jj-font-caption);
}

.home-author-action {
  min-width: 0;
  min-height: 56rpx;
  padding-right: 18rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.home-author-avatar {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.home-author-row .author {
  height: 32rpx;
  display: block;
  line-height: 32rpx;
}

.home-summary-row {
  min-width: 0;
  margin-top: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.home-card .article-brief {
  min-width: 0;
  margin-top: 0;
  flex: 1;
  font-size: var(--jj-font-caption);
  line-height: 1.55;
  -webkit-line-clamp: 2;
}

.home-card .home-cover {
  width: 166rpx;
  height: 108rpx;
}

.home-card .home-stats {
  min-height: 42rpx;
  margin-top: 14rpx;
  display: flex;
  gap: 28rpx;
}

.home-stats .stat {
  height: 32rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.home-stats .stat-icon {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 auto;
}

.home-stats .stat-label {
  height: 28rpx;
  display: block;
  line-height: 28rpx;
}

.home-tag {
  margin-left: auto;
  max-width: 150rpx;
  padding: 5rpx 12rpx;
  overflow: hidden;
  border-radius: 4rpx;
  color: var(--jj-text-3);
  background: var(--jj-fill);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-dislike {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  margin-left: -4rpx;
  flex: 0 0 auto;
}

.home-dislike::before,
.home-dislike::after {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 9rpx;
  width: 2rpx;
  height: 24rpx;
  border-radius: 1rpx;
  background: var(--jj-text-3);
}

.home-dislike::before { transform: rotate(45deg); }
.home-dislike::after { transform: rotate(-45deg); }

.home-dislike .dislike-mark {
  display: none;
}
