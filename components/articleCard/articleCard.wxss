.article-card {
  min-height: 246rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  border-bottom: 1rpx solid var(--jj-line);
}

.article-main {
  min-width: 0;
  flex: 1;
}

.article-meta,
.article-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.author {
  max-width: 200rpx;
  overflow: hidden;
  color: var(--jj-text-2);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  max-width: 120rpx;
  padding-left: 12rpx;
  overflow: hidden;
  border-left: 1rpx solid var(--jj-line);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-title {
  margin-top: 16rpx;
  color: var(--jj-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.42;
}

.article-brief {
  margin-top: 10rpx;
  color: var(--jj-text-3);
  font-size: 25rpx;
  line-height: 1.55;
}

.article-stats {
  margin-top: 18rpx;
  gap: 30rpx;
}

.article-cover {
  width: 180rpx;
  height: 120rpx;
  flex: 0 0 auto;
  border-radius: 4rpx;
  background: var(--jj-fill);
}

.rank {
  width: 36rpx;
  color: var(--jj-text-3);
  font-size: 28rpx;
  font-weight: 700;
  font-style: italic;
}

.rank-1 { color: #f53f3f; }
.rank-2 { color: #ff7d00; }
.rank-3 { color: #ffb400; }

.article-card.compact {
  min-height: 194rpx;
  padding: 22rpx 24rpx;
  gap: 18rpx;
}

.compact .article-meta,
.compact .article-stats {
  font-size: 20rpx;
}

.compact .article-title {
  margin-top: 12rpx;
  font-size: 28rpx;
}

.compact .article-brief {
  margin-top: 8rpx;
  font-size: 22rpx;
  -webkit-line-clamp: 1;
}

.compact .article-stats {
  margin-top: 12rpx;
  gap: 22rpx;
}

.compact .article-cover {
  width: 150rpx;
  height: 100rpx;
}

.article-card.home-card {
  min-height: 244rpx;
  padding: 26rpx 30rpx;
  align-items: center;
  border-bottom: 14rpx solid var(--jj-bg);
}

.home-card .article-title {
  margin-top: 0;
  font-size: 29rpx;
}

.home-author-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.home-author-row image {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
}

.home-card .article-brief {
  margin-top: 14rpx;
  font-size: 23rpx;
  -webkit-line-clamp: 2;
}

.home-card .home-stats {
  margin-top: 18rpx;
  display: flex;
}

.home-tag {
  margin-left: auto;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
  color: var(--jj-text-3);
  background: var(--jj-fill);
}

.home-more {
  margin-left: 4rpx;
}
