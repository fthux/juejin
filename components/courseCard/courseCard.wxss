.course-card {
  min-height: 240rpx;
  padding: 28rpx 30rpx;
  display: flex;
  gap: 24rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  border-bottom: 1rpx solid var(--jj-line);
}

.course-cover-wrap {
  position: relative;
  width: 124rpx;
  height: 174rpx;
  flex: 0 0 auto;
  border-radius: 6rpx;
  overflow: hidden;
  background: var(--jj-fill);
}

.course-cover {
  width: 100%;
  height: 100%;
}

.course-vip-label {
  position: absolute;
  top: 0;
  left: 0;
  min-width: 52rpx;
  height: 30rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  border-bottom-right-radius: 7rpx;
  color: #6b3f00;
  background: #f8d88a;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}

.course-body {
  min-width: 0;
  flex: 1;
}

.course-title {
  color: var(--jj-text);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
}

.new-label {
  margin-right: 9rpx;
  padding: 2rpx 7rpx;
  border-radius: 3rpx;
  color: #ffffff;
  background: #f53f3f;
  font-size: 19rpx;
  font-weight: 500;
  vertical-align: 3rpx;
}

.course-author {
  margin-top: 12rpx;
  color: var(--jj-text-3);
  font-size: 23rpx;
}

.author-level {
  margin-left: 7rpx;
  padding: 1rpx 7rpx;
  border-radius: 3rpx;
  color: #eaf4ff;
  background: #2366b1;
  font-size: 18rpx;
  font-style: italic;
  font-weight: 700;
}

.course-meta {
  margin-top: 12rpx;
  color: var(--jj-text-3);
  font-size: 22rpx;
}

.course-footer {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.free-price {
  color: var(--jj-blue);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.price {
  color: #f53f3f;
  font-size: 30rpx;
  font-weight: 600;
}

.price-symbol {
  margin-right: 4rpx;
  font-size: 22rpx;
}

.original-price {
  color: var(--jj-text-3);
  font-size: 20rpx;
  text-decoration: line-through;
}

.discount-label {
  padding: 3rpx 10rpx;
  border: 1rpx solid rgba(245, 63, 63, 0.35);
  border-radius: 14rpx;
  color: #f53f3f;
  font-size: 18rpx;
}

.owned {
  color: #1e80ff;
  font-size: 26rpx;
}
