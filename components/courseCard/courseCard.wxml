<view class="course-card" bindtap="open">
  <image class="course-cover" src="{{item.cover}}" mode="aspectFill"></image>
  <view class="course-body">
    <view class="course-title two-lines">{{item.title}}</view>
    <view class="course-summary two-lines">{{item.summary}}</view>
    <view class="course-author">{{item.author}} · {{item.section_count}} 小节</view>
    <view class="course-footer">
      <text wx:if="{{item.owned}}" class="owned">已购</text>
      <text wx:elif="{{item.price}}" class="price">¥ {{item.price}}</text>
      <text wx:else class="free">免费</text>
      <text class="study">{{item.is_finished ? '已完结' : '连载中'}}</text>
    </view>
  </view>
</view>
